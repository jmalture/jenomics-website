---
/**
 * Hero visual: one live app window instead of a carousel. A slim icon rail lists the 6 services and
 * our products; the main pane shows one service at a time as a small live product UI (dashboard, code
 * editor, website building itself, terminal, network, rack, product apps).
 *
 * - A cursor clicks the next rail icon, the pane switches and its little story starts fresh (warning
 *   resolved, build passed, ...), then the cursor points at the interesting spot ([data-poi]).
 * - Each switch re-themes the hero (registered --hA/--hB/--hC, so the colours blend).
 * - Rail icons and the pane title link to the pages; hovering an icon previews it and the cursor steps aside.
 * - Pauses off screen, in hidden tabs and on hover; reduced motion: no autoplay.
 * - Sized in container units (cqw), so the window scales as one piece down to mobile.
 *
 * Texts: offer.json (names, links) + home.json "hero_slider_*" / "hero_ui".
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
import offer from '../../i18n/offer.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data, lang) as Record<string, any>;
const o = pick(offer, lang);
const ui = t.hero_ui as Record<string, any>;

type Pal = [string, string, string];
const svc = (k: string) => o.services.find((s) => s.key === k)!;
// Rail order and palettes (A, B, C); same colours as the service pages.
const items = [
  { key: 'it', icon: 'it', ...svc('it'), pal: ['#1a8fe0', '#3fc6f2', '#2ee59d'] },
  { key: 'dev', icon: 'dev', ...svc('dev'), pal: ['#2a3bc8', '#1a6fe0', '#29a8ef'] },
  { key: 'web', icon: 'web', ...svc('web'), pal: ['#20d3c2', '#2ee59d', '#1ab8e8'] },
  { key: 'linux', icon: 'linux', ...svc('linux'), pal: ['#1e3d7e', '#0e78b1', '#3fc6f2'] },
  { key: 'net', icon: 'net', ...svc('net'), pal: ['#0e78b1', '#20d3c2', '#56c657'] },
  { key: 'host', icon: 'host', ...svc('host'), pal: ['#56c657', '#2ee59d', '#20d3c2'] },
  {
    key: 'products',
    icon: 'apps',
    name: t.hero_slider_products_title,
    href: t.hero_slider_products_href,
    pal: ['#2a3bc8', '#29a8ef', '#2ee59d'],
  },
].map(({ key, icon, name, href, pal }) => ({ key, icon, name, href, pal: pal as Pal }));

const terminal = [
  ['$', 'ssh admin@srv-01'],
  ['$', 'apt upgrade -y'],
  ['✓', t.hero_slider_term_ok],
  ['$', 'ansible-playbook rollout.yml'],
  ['✓', 'failed=0'],
];
// Code editor: each line = indent + tokens [colour, width in em]
const code: [number, [string, number][]][] = [
  [
    0,
    [
      ['k', 3],
      ['f', 5],
      ['p', 1.2],
    ],
  ],
  [
    1,
    [
      ['k', 2.4],
      ['p', 3],
      ['s', 6],
    ],
  ],
  [
    1,
    [
      ['f', 4],
      ['p', 1.4],
      ['p', 4.2],
    ],
  ],
  [
    2,
    [
      ['k', 2.6],
      ['s', 7.4],
    ],
  ],
  [
    2,
    [
      ['f', 3.4],
      ['p', 2.2],
    ],
  ],
  [1, [['p', 1]]],
  [0, [['p', 0.8]]],
];
const nodes = [
  [16, 24],
  [84, 20],
  [90, 72],
  [58, 90],
  [12, 78],
];
const check =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---

<div
  class="jx-live"
  data-live-hero
  data-live
  data-palettes={JSON.stringify(items.map((it) => it.pal))}
  role="group"
  aria-label={t.hero_slider_label}
>
  <div class="jx-app">
    <div class="jx-app__top" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="jx-app__body">
      <nav class="jx-app__rail">
        <span class="jx-app__ink" aria-hidden="true"></span>
        {
          items.map((it, i) => (
            <a
              class:list={['jx-app__tab', { 'is-on': i === 0 }]}
              href={it.href}
              data-tab={i}
              data-name={it.name}
              aria-label={it.name}
            >
              <Icon name={it.icon as any} size={20} />
              <span class="jx-app__tip" aria-hidden="true">
                {it.name}
              </span>
            </a>
          ))
        }
      </nav>

      <div class="jx-app__main">
        <a class="jx-app__head" href={items[0].href} data-head>
          <span class="jx-app__num" data-head-num>01</span>
          <span class="jx-app__title" data-head-name>{items[0].name}</span>
          <span class="jx-app__go"><Icon name="arrow" size={16} /></span>
        </a>

        <div class="jx-app__panes" aria-hidden="true">
          <!-- IT Administration: systems dashboard -->
          <div class="jx-pane jx-pane--it is-on">
            <div class="jx-hcard">
              <div class="jx-hcard__bar"><span class="jx-dot-live"></span>{ui.systems}<em>{ui.live}</em></div>
              <div class="jx-mon">
                <div class="jx-mon__rows">
                  {
                    (ui.hosts as string[]).map((h, k) => (
                      <div class:list={['jx-mon__row', { 'is-flaky': k === 2 }]} data-poi={k === 2 ? '' : undefined}>
                        <i />
                        {h}
                        <span class="jx-mon__pill">
                          <span class="jx-mon__ok">{ui.ok}</span>
                          {k === 2 && <span class="jx-mon__warn">{ui.warn}</span>}
                        </span>
                      </div>
                    ))
                  }
                </div>
                <div class="jx-mon__bars">
                  {Array.from({ length: 12 }, (_, k) => <i style={`--k:${k}`} />)}
                </div>
              </div>
            </div>
            <span class="jx-toast"><i set:html={check} />{ui.fixed}</span>
          </div>

          <!-- Software development: code editor -->
          <div class="jx-pane jx-pane--dev">
            <div class="jx-hcard jx-hcard--dark">
              <div class="jx-hcard__bar"><i></i><i></i><i></i><em>app.ts</em></div>
              <div class="jx-code">
                {
                  code.map(([indent, toks], k) => (
                    <div class="jx-code__ln" style={`--k:${k};--in:${indent}`} data-poi={k === 3 ? '' : undefined}>
                      <small>{k + 1}</small>
                      <span style={`width:${indent * 1.4}em`} />
                      {toks.map(([c, w]) => (
                        <i class={`t-${c}`} style={`width:${w}em`} />
                      ))}
                    </div>
                  ))
                }
              </div>
            </div>
            <span class="jx-toast jx-toast--late"><i set:html={check} />{ui.build}</span>
          </div>

          <!-- Website & Branding: a page assembling itself -->
          <div class="jx-pane jx-pane--web">
            <div class="jx-hcard">
              <div class="jx-hcard__bar"><i></i><i></i><i></i><span class="jx-site__url"></span></div>
              <div class="jx-site">
                <div class="jx-site__nav" style="--k:0"><b></b><i></i><i></i><i></i></div>
                <div class="jx-site__hero" style="--k:1" data-poi><i></i><i></i><b></b></div>
                <div class="jx-site__cards"><i style="--k:2"></i><i style="--k:3"></i><i style="--k:4"></i></div>
              </div>
            </div>
          </div>

          <!-- Linux & Unix: terminal -->
          <div class="jx-pane jx-pane--linux">
            <div class="jx-hcard jx-hcard--dark">
              <div class="jx-hcard__bar"><i></i><i></i><i></i><em>bash</em></div>
              <div class="jx-term">
                {
                  terminal.map(([p, line], k) => (
                    <div
                      class:list={['jx-term__ln', { 'is-ok': p !== '$' }]}
                      style={`--k:${k}`}
                      data-poi={k === 4 ? '' : undefined}
                    >
                      <b>{p}</b> {line}
                    </div>
                  ))
                }
                <div class="jx-term__ln" style={`--k:${terminal.length}`}>
                  <b>$</b>
                  <span class="jx-term__cursor"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Infrastructure & network -->
          <div class="jx-pane jx-pane--net">
            <div class="jx-hcard jx-hcard--net">
              <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
                {
                  nodes.map(([x, y], k) => (
                    <g style={`--k:${k}`}>
                      <line class="jx-net__base" x1="50" y1="50" x2={x} y2={y} />
                      <line class="jx-net__pulse" x1="50" y1="50" x2={x} y2={y} />
                      <circle class="jx-net__node" cx={x} cy={y} r="5" />
                    </g>
                  ))
                }
                <circle class="jx-net__hub" cx="50" cy="50" r="11"></circle>
                <image href="/media/jenomics-signet.png" x="42.5" y="42.5" width="15" height="15" />
              </svg>
              <span class="jx-net__poi" data-poi></span>
            </div>
          </div>

          <!-- Hosting -->
          <div class="jx-pane jx-pane--host">
            <div class="jx-rack">
              {
                [0, 1, 2, 3].map((k) => (
                  <div class="jx-rack__u" style={`--k:${k}`}>
                    <i />
                    <b />
                    <b />
                  </div>
                ))
              }
            </div>
            <span class="jx-green" data-poi><Icon name="leaf" size={16} />{t.hero_pill_green}</span>
          </div>

          <!-- Own products -->
          <div class="jx-pane jx-pane--products">
            {
              o.products.map((p, k) => (
                <div class="jx-prod" style={`--k:${k}`} data-poi={k === 1 ? '' : undefined}>
                  <img src={p.icon} alt="" width="64" height="64" decoding="async" loading="lazy" />
                  <span>{p.name}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <span class="jx-live__cursor" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M4 2.5 20 11l-7 1.8L9.2 20z"></path></svg>
  </span>
</div>

<style is:global>
  /* Palette channels: registered so they interpolate when the hero re-themes */
  @property --hA {
    syntax: '<color>';
    inherits: true;
    initial-value: #1a8fe0;
  }
  @property --hB {
    syntax: '<color>';
    inherits: true;
    initial-value: #3fc6f2;
  }
  @property --hC {
    syntax: '<color>';
    inherits: true;
    initial-value: #2ee59d;
  }
  .jx-hero {
    transition:
      --hA 1.6s var(--jx-ease-io),
      --hB 1.6s var(--jx-ease-io),
      --hC 1.6s var(--jx-ease-io);
  }

  /* ---------- Window ---------- */
  .jx-live {
    --ok: #2fb35a;
    --warn: #e8a317;
    position: relative;
    container-type: inline-size;
    user-select: none;
  }
  .jx-app {
    position: relative;
    z-index: 1;
    font-size: 2.1cqw;
    line-height: 1.3;
    color: var(--jx-ink);
    border-radius: 1.6em;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow:
      var(--jx-shadow-lg),
      0 0 0 1px color-mix(in srgb, var(--hB) 22%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transform: perspective(1400px) rotateX(calc(var(--ry, 0) * -2deg)) rotateY(calc(var(--rx, 0) * 3deg));
    transition: transform 1.2s var(--jx-ease);
  }
  .js .jx-app {
    animation: jx-app-in 1.2s var(--jx-ease) 0.3s backwards;
  }
  @keyframes jx-app-in {
    from {
      opacity: 0;
      translate: 0 2em;
      filter: blur(8px);
    }
  }
  .jx-app__top {
    display: flex;
    gap: 0.5em;
    padding: 1em 1.2em;
  }
  .jx-app__top i {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    background: #d5dde6;
  }
  .jx-app__body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1em;
    padding: 0 1.2em 1.2em 0.9em;
  }

  /* Rail */
  .jx-app__rail {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: start;
    gap: 0.45em;
  }
  .jx-app__tab {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3em;
    height: 3em;
    border-radius: 0.9em;
    color: #8193ad;
    transition: color 0.6s var(--jx-ease);
  }
  .jx-app__tab svg {
    width: 1.5em;
    height: 1.5em;
  }
  .jx-app__tab:hover,
  .jx-app__tab.is-on {
    color: #fff;
  }
  .jx-app__tab:not(.is-on):hover {
    color: var(--jx-navy);
  }
  .jx-app__tab:focus-visible {
    outline: 2px solid var(--jx-blue);
    outline-offset: 2px;
  }
  /* Tooltip: on hover, and when the demo cursor arrives (.is-tip) */
  .jx-app__tip {
    position: absolute;
    left: calc(100% + 0.8em);
    top: 50%;
    padding: 0.45em 0.8em;
    border-radius: 0.55em;
    background: var(--jx-night);
    color: #fff;
    font-weight: 500;
    font-size: 0.95em;
    white-space: nowrap;
    box-shadow: 0 0.6em 1.4em rgba(11, 26, 54, 0.25);
    opacity: 0;
    translate: -0.4em -50%;
    pointer-events: none;
    transition:
      opacity 0.25s var(--jx-ease),
      translate 0.35s var(--jx-ease);
  }
  .jx-app__tip::before {
    content: '';
    position: absolute;
    left: -0.3em;
    top: 50%;
    width: 0.7em;
    height: 0.7em;
    background: inherit;
    border-radius: 0.12em;
    translate: 0 -50%;
    rotate: 45deg;
  }
  .jx-app__tab:hover .jx-app__tip,
  .jx-app__tab:focus-visible .jx-app__tip,
  .jx-app__tab.is-tip .jx-app__tip {
    opacity: 1;
    translate: 0 -50%;
  }
  .jx-app__ink {
    position: absolute;
    left: 0;
    top: 0;
    width: 3em;
    height: 3em;
    border-radius: 0.9em;
    background: linear-gradient(140deg, var(--hA), var(--hB));
    box-shadow: 0 0.5em 1.2em color-mix(in srgb, var(--hA) 35%, transparent);
    translate: 0 calc(var(--tab, 0) * 3.45em);
    transition: translate 0.8s var(--jx-ease);
  }
  .jx-live.is-click .jx-app__ink {
    animation: jx-press 0.45s var(--jx-ease);
  }
  @keyframes jx-press {
    40% {
      scale: 0.9;
    }
  }

  /* Main */
  .jx-app__main {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    border-radius: 1.1em;
    background: linear-gradient(160deg, #fff, #f4f8fb);
    box-shadow: inset 0 0 0 1px rgba(30, 61, 126, 0.06);
  }
  .jx-app__head {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    justify-self: start;
    padding: 0.9em 1.2em 0.1em;
    color: var(--jx-navy);
    text-decoration: none;
  }
  .jx-app__num {
    font-size: 0.95em;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--hA);
  }
  .jx-app__title {
    font-size: 1.9em;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    animation: jx-title 0.7s var(--jx-ease);
  }
  .jx-app__go {
    display: grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(140deg, var(--hA), var(--hB));
    box-shadow: 0 0.4em 1em color-mix(in srgb, var(--hA) 30%, transparent);
    transition: translate var(--jx-fast) var(--jx-ease);
  }
  .jx-app__go svg {
    width: 1em;
    height: 1em;
  }
  .jx-app__head:hover .jx-app__go {
    translate: 0.25em 0;
  }
  @keyframes jx-title {
    from {
      opacity: 0;
      translate: 0 0.4em;
    }
  }
  .jx-app__panes {
    position: relative;
    display: grid;
    grid-template: 22em / minmax(0, 1fr);
  }
  .jx-pane {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 1em 1.3em 1.4em;
    opacity: 0;
    visibility: hidden;
    translate: 0 0.8em;
    filter: blur(4px);
    transition:
      opacity 0.6s var(--jx-ease),
      translate 0.8s var(--jx-ease),
      filter 0.6s var(--jx-ease),
      visibility 0s 0.6s;
  }
  .jx-pane.is-on {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    filter: none;
    transition:
      opacity 0.7s var(--jx-ease) 0.15s,
      translate 0.9s var(--jx-ease) 0.15s,
      filter 0.7s var(--jx-ease) 0.15s,
      visibility 0s;
  }

  /* Shared card inside a pane */
  .jx-hcard {
    position: relative;
    width: 100%;
    border-radius: 1em;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(30, 61, 126, 0.07),
      0 1em 2.4em rgba(30, 61, 126, 0.1);
    overflow: hidden;
  }
  .jx-hcard--dark {
    background: linear-gradient(180deg, #13284f, var(--jx-night));
    color: #d8e3f3;
    box-shadow: 0 1.2em 2.6em rgba(11, 26, 54, 0.28);
  }
  .jx-hcard__bar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.75em 1em;
    border-bottom: 1px solid rgba(30, 61, 126, 0.08);
    font-weight: 600;
    font-size: 0.9em;
    color: var(--jx-navy);
  }
  .jx-hcard--dark .jx-hcard__bar {
    border-color: rgba(255, 255, 255, 0.07);
    color: #8ea3c4;
  }
  .jx-hcard__bar > i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: #d5dde6;
  }
  .jx-hcard--dark .jx-hcard__bar > i {
    background: #2b4372;
  }
  .jx-hcard__bar em {
    margin-left: auto;
    font-style: normal;
    font-weight: 500;
  }
  .jx-pane--it .jx-hcard__bar em {
    color: var(--ok);
  }
  .jx-dot-live {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--ok);
    animation: jx-live-pulse 2s ease-out infinite;
  }
  @keyframes jx-live-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.6em transparent;
    }
  }

  /* Toast: pops once the pane's story has happened */
  .jx-toast {
    position: absolute;
    right: 1.3em;
    bottom: 0.5em;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em 0.5em 0.55em;
    border-radius: 999px;
    background: #fff;
    font-weight: 500;
    font-size: 0.95em;
    white-space: nowrap;
    box-shadow: 0 0.8em 2em rgba(30, 61, 126, 0.2);
    opacity: 0;
    translate: 0 0.6em;
  }
  .jx-toast > i {
    display: grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    padding: 0.38em;
    border-radius: 50%;
    color: #fff;
    background: var(--ok);
  }
  .is-on > .jx-toast {
    animation: jx-toast 0.8s var(--jx-ease) 2.4s forwards;
  }
  .is-on > .jx-toast--late {
    animation-delay: 3.4s;
  }
  @keyframes jx-toast {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---------- IT dashboard ---------- */
  .jx-mon {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.2em;
    padding: 0.8em 1em 1.2em;
  }
  .jx-mon__row {
    display: grid;
    grid-template-columns: 0.6em 1fr auto;
    align-items: center;
    gap: 0.65em;
    padding: 0.55em 0;
  }
  .jx-mon__row + .jx-mon__row {
    border-top: 1px solid rgba(30, 61, 126, 0.06);
  }
  .jx-mon__row > i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--ok);
  }
  .jx-mon__pill {
    display: grid;
    min-width: 4em;
    font-size: 0.85em;
    font-weight: 600;
    text-align: center;
  }
  .jx-mon__pill > span {
    grid-area: 1 / 1;
    padding: 0.15em 0.6em;
    border-radius: 999px;
  }
  .jx-mon__ok {
    color: var(--ok);
    background: color-mix(in srgb, var(--ok) 13%, #fff);
  }
  .jx-mon__warn {
    color: #a86f00;
    background: color-mix(in srgb, var(--warn) 22%, #fff);
    opacity: 0;
  }
  /* Backup turns to "Prüfen" and back to OK, then the toast confirms */
  .is-on .jx-mon__warn {
    animation: jx-warn 2.6s var(--jx-ease-io) 0.4s both;
  }
  .is-on .jx-mon__ok:has(+ .jx-mon__warn) {
    animation: jx-okflip 2.6s var(--jx-ease-io) 0.4s both;
  }
  .is-on .is-flaky > i {
    animation: jx-led 2.6s var(--jx-ease-io) 0.4s both;
  }
  @keyframes jx-warn {
    0%,
    100% {
      opacity: 0;
    }
    15%,
    80% {
      opacity: 1;
    }
  }
  @keyframes jx-okflip {
    0%,
    100% {
      opacity: 1;
    }
    15%,
    80% {
      opacity: 0;
    }
  }
  @keyframes jx-led {
    0%,
    100% {
      background: var(--ok);
    }
    15%,
    80% {
      background: var(--warn);
    }
  }
  .jx-mon__bars {
    display: flex;
    align-items: flex-end;
    gap: 0.35em;
    padding: 0.7em;
    border-radius: 0.8em;
    background: linear-gradient(180deg, #f5f8fc, #fff);
  }
  .jx-mon__bars i {
    flex: 1;
    height: 100%;
    border-radius: 0.25em 0.25em 0.1em 0.1em;
    background: linear-gradient(180deg, var(--hB), var(--hC));
    transform-origin: bottom;
    animation: jx-bar 3.2s var(--jx-ease-io) infinite alternate;
    animation-delay: calc(var(--k) * -0.41s);
  }
  @keyframes jx-bar {
    from {
      transform: scaleY(0.22);
    }
    to {
      transform: scaleY(0.92);
    }
  }

  /* ---------- Code editor: lines type in ---------- */
  .jx-code {
    display: grid;
    gap: 0.65em;
    padding: 1em 1.1em 1.4em;
  }
  .jx-code__ln {
    display: flex;
    align-items: center;
    gap: 0.45em;
    clip-path: inset(0 100% 0 0);
  }
  .is-on .jx-code__ln {
    animation: jx-type 0.5s steps(10, end) forwards;
    animation-delay: calc(var(--k) * 0.42s + 0.4s);
  }
  @keyframes jx-type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .jx-code__ln small {
    width: 1.4em;
    font-size: 0.8em;
    color: #4a6491;
    text-align: right;
  }
  .jx-code__ln i {
    height: 0.65em;
    border-radius: 0.33em;
  }
  .t-k {
    background: #7f9bff;
  }
  .t-f {
    background: var(--hB);
  }
  .t-s {
    background: #57e39a;
  }
  .t-p {
    background: #50678f;
  }

  /* ---------- Website building itself ---------- */
  .jx-site__url {
    flex: 1;
    height: 1.3em;
    margin-left: 0.6em;
    border-radius: 0.65em;
    background: #eef2f6;
  }
  .jx-site {
    display: grid;
    gap: 0.8em;
    padding: 0.9em;
  }
  .jx-site__nav,
  .jx-site__hero,
  .jx-site__cards i {
    opacity: 0;
    translate: 0 0.7em;
  }
  .is-on .jx-site__nav,
  .is-on .jx-site__hero,
  .is-on .jx-site__cards i {
    animation: jx-build 0.8s var(--jx-ease) forwards;
    animation-delay: calc(var(--k) * 0.45s + 0.4s);
  }
  @keyframes jx-build {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  .jx-site__nav {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .jx-site__nav b {
    width: 1.4em;
    height: 1.4em;
    margin-right: auto;
    border-radius: 0.45em;
    background: linear-gradient(140deg, var(--hA), var(--hC));
  }
  .jx-site__nav i {
    width: 2.6em;
    height: 0.5em;
    border-radius: 0.3em;
    background: #e3e9ef;
  }
  .jx-site__hero {
    display: grid;
    gap: 0.5em;
    align-content: center;
    height: 7em;
    padding: 0 1.2em;
    border-radius: 0.9em;
    background:
      radial-gradient(70% 120% at 100% 0%, color-mix(in srgb, var(--hC) 70%, transparent), transparent 70%),
      linear-gradient(135deg, var(--hA), var(--hB));
  }
  .jx-site__hero i {
    width: 58%;
    height: 0.8em;
    border-radius: 0.4em;
    background: rgba(255, 255, 255, 0.95);
  }
  .jx-site__hero i + i {
    width: 40%;
    height: 0.5em;
    background: rgba(255, 255, 255, 0.7);
  }
  .jx-site__hero b {
    width: 4em;
    height: 1.4em;
    margin-top: 0.3em;
    border-radius: 0.45em;
    background: #fff;
  }
  .jx-site__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6em;
  }
  .jx-site__cards i {
    height: 3.4em;
    border-radius: 0.7em;
    background: #f1f5f9;
    box-shadow: inset 0 0.55em 0 color-mix(in srgb, var(--hB) 30%, #f1f5f9);
  }

  /* ---------- Terminal ---------- */
  .jx-term {
    display: grid;
    gap: 0.45em;
    padding: 1em 1.2em 1.3em;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.98em;
  }
  .jx-term__ln {
    white-space: nowrap;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
  }
  .is-on .jx-term__ln {
    animation: jx-type 0.7s steps(22, end) forwards;
    animation-delay: calc(var(--k) * 0.6s + 0.4s);
  }
  .jx-term b {
    color: var(--hB);
  }
  .jx-term__ln.is-ok,
  .jx-term__ln.is-ok b {
    color: #57e39a;
  }
  .jx-term__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.15em;
    background: #d8e3f3;
    animation: jx-blink 1s steps(1) infinite;
  }
  @keyframes jx-blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Network ---------- */
  .jx-hcard--net {
    height: 100%;
    background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--hB) 12%, #fff), #fff);
  }
  .jx-hcard--net svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .jx-net__base {
    stroke: color-mix(in srgb, var(--hA) 22%, #e3eaf1);
    stroke-width: 1;
  }
  .jx-net__pulse {
    stroke: var(--hB);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 5 60;
    animation: jx-flow 2.4s linear infinite;
    animation-delay: calc(var(--k) * -0.48s);
  }
  @keyframes jx-flow {
    from {
      stroke-dashoffset: 65;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .jx-net__node {
    fill: #fff;
    stroke: var(--hA);
    stroke-width: 1.3;
  }
  .is-on .jx-net__node {
    animation: jx-node 1.2s var(--jx-ease) both;
    animation-delay: calc(var(--k) * 0.18s + 0.5s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes jx-node {
    50% {
      fill: var(--hC);
      scale: 1.35;
    }
  }
  .jx-net__hub {
    fill: #fff;
    stroke: color-mix(in srgb, var(--hB) 45%, transparent);
    stroke-width: 3;
  }
  .jx-net__poi {
    position: absolute;
    left: 66%;
    top: 30%;
  }

  /* ---------- Hosting ---------- */
  .jx-pane--host {
    align-content: center;
    gap: 1em;
  }
  .jx-rack {
    display: grid;
    gap: 0.45em;
    width: min(100%, 24em);
    padding: 0.6em;
    border-radius: 0.9em;
    background: linear-gradient(180deg, #13284f, var(--jx-night));
    box-shadow: 0 1.2em 2.6em rgba(11, 26, 54, 0.28);
  }
  .jx-rack__u {
    display: flex;
    align-items: center;
    gap: 0.45em;
    height: 2.4em;
    padding: 0 0.9em;
    border-radius: 0.45em;
    background: linear-gradient(180deg, #1f3a6b, #182f59);
  }
  .jx-rack__u i {
    width: 55%;
    height: 0.7em;
    margin-right: auto;
    border-radius: 0.2em;
    background: repeating-linear-gradient(90deg, #2c4c84 0 0.2em, #22406f 0.2em 0.4em);
  }
  .jx-rack__u b {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #3ee68a;
    box-shadow: 0 0 0.5em #3ee68a;
    animation: jx-blink 1.4s steps(1) infinite;
    animation-delay: calc(var(--k) * -0.45s);
  }
  .jx-rack__u b + b {
    background: var(--hB);
    box-shadow: 0 0 0.5em var(--hB);
    animation-duration: 2.1s;
  }
  .jx-green {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em 0.5em 0.7em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--jx-green) 15%, #fff);
    color: #2a8a35;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: 0 0.6em;
  }
  .jx-green svg {
    width: 1.2em;
    height: 1.2em;
  }
  .is-on .jx-green {
    animation: jx-toast 0.8s var(--jx-ease) 0.9s forwards;
  }

  /* ---------- Products ---------- */
  .jx-pane--products {
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
  }
  .jx-prod {
    justify-self: stretch;
    display: grid;
    justify-items: center;
    gap: 0.8em;
    padding: 1.4em 0.6em 1.2em;
    border-radius: 1em;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(30, 61, 126, 0.07),
      0 1em 2.4em rgba(30, 61, 126, 0.1);
    font-weight: 600;
    font-size: 0.9em;
    text-align: center;
    color: var(--jx-navy);
    opacity: 0;
    translate: 0 0.7em;
  }
  .is-on .jx-prod {
    animation: jx-build 0.8s var(--jx-ease) forwards;
    animation-delay: calc(var(--k) * 0.25s + 0.4s);
  }
  .jx-prod img {
    width: 4.2em;
    height: 4.2em;
    object-fit: contain;
  }

  /* ---------- Cursor ---------- */
  .jx-live__cursor {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 0;
    pointer-events: none;
    translate: var(--cx, 50cqw) var(--cy, 40cqw);
    transition:
      translate 1.1s var(--jx-ease-io),
      opacity 0.4s var(--jx-ease);
    opacity: 0;
  }
  .jx-live.is-ready .jx-live__cursor {
    opacity: 1;
  }
  .jx-live.is-hover .jx-live__cursor {
    opacity: 0;
  }
  .jx-live__cursor svg {
    width: 4cqw;
    height: 4cqw;
    filter: drop-shadow(0 0.2em 0.3em rgba(11, 26, 54, 0.3));
  }
  .jx-live__cursor path {
    fill: var(--jx-night);
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .jx-live.is-click .jx-live__cursor svg {
    animation: jx-press 0.45s var(--jx-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .jx-code__ln,
    .jx-term__ln {
      clip-path: none;
    }
    .jx-site__nav,
    .jx-site__hero,
    .jx-site__cards i,
    .jx-prod,
    .jx-green,
    .jx-toast {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-live-hero]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('.jx-pane')];
    const rail = root.querySelector<HTMLElement>('.jx-app__rail')!;
    const head = root.querySelector<HTMLAnchorElement>('[data-head]')!;
    const headName = root.querySelector<HTMLElement>('[data-head-name]')!;
    const headNum = root.querySelector<HTMLElement>('[data-head-num]')!;
    const cursor = root.querySelector<HTMLElement>('.jx-live__cursor')!;
    const theme = (root.closest('.jx-hero') as HTMLElement) ?? root;
    const pals: [string, string, string][] = JSON.parse(root.dataset.palettes || '[]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = tabs.length;
    const STAY = 3600; // cursor rests on the pane's point of interest
    let idx = 0;
    let timer = 0;
    let inView = true;
    let hover = false;

    // Cursor tip to the centre-ish of an element (stage = .jx-live)
    const aim = (el: Element, fx = 0.5, fy = 0.5) => {
      const s = root.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      cursor.style.setProperty('--cx', `${r.left - s.left + r.width * fx}px`);
      cursor.style.setProperty('--cy', `${r.top - s.top + r.height * fy}px`);
    };
    const show = (k: number) => {
      idx = ((k % n) + n) % n;
      tabs.forEach((t, i) => t.classList.toggle('is-on', i === idx));
      panes.forEach((p, i) => {
        if (i === idx) {
          // restart the pane's story (typing, building, warning → OK)
          p.classList.remove('is-on');
          void p.offsetWidth;
        }
        p.classList.toggle('is-on', i === idx);
      });
      rail.style.setProperty('--tab', String(idx));
      const [a, b, c] = pals[idx] ?? [];
      if (a) {
        theme.style.setProperty('--hA', a);
        theme.style.setProperty('--hB', b);
        theme.style.setProperty('--hC', c);
      }
      head.href = tabs[idx].href;
      headName.textContent = tabs[idx].dataset.name ?? '';
      headNum.textContent = String(idx + 1).padStart(2, '0');
      // replay the title's entrance
      headName.style.animation = 'none';
      void headName.offsetWidth;
      headName.style.animation = '';
    };
    const held = () => hover || !inView || document.hidden;
    const later = (fn: () => void, ms: number) => {
      clearTimeout(timer);
      timer = window.setTimeout(() => (held() ? later(fn, 500) : fn()), ms);
    };

    // Loop: point at the story → move to the next icon → click → switch → point at the story ...
    const pointAt = () => {
      const poi = panes[idx].querySelector('[data-poi]') ?? panes[idx];
      aim(poi, 0.62, 0.55);
      later(toNext, STAY);
    };
    const tipOff = () => tabs.forEach((t) => t.classList.remove('is-tip'));
    const toNext = () => {
      const next = tabs[(idx + 1) % n];
      aim(next, 0.55, 0.6);
      // the tooltip shows once the cursor has arrived, like a real hover
      window.setTimeout(() => !hover && next.classList.add('is-tip'), 900);
      later(click, 1250);
    };
    const click = () => {
      root.classList.remove('is-click');
      void root.offsetWidth;
      root.classList.add('is-click');
      show(idx + 1);
      window.setTimeout(tipOff, 900);
      later(pointAt, 900);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        hover = true;
        root.classList.add('is-hover');
        if (i !== idx) show(i);
      });
      t.addEventListener('focus', () => i !== idx && show(i));
    });
    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = true;
      root.classList.add('is-hover');
      tipOff();
    });
    root.addEventListener('pointerleave', () => {
      hover = false;
      root.classList.remove('is-hover');
      if (!reduce) later(pointAt, 300);
    });
    new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.3 }).observe(root);

    show(0);
    if (reduce) return;
    // start after the hero has settled; the cursor fades in on the first point of interest
    window.setTimeout(() => {
      pointAt();
      window.setTimeout(() => root.classList.add('is-ready'), 50);
    }, 1400);
  });
</script>
