---
/**
 * Section "portfolio" (dark): all 6 services and the 3 own products from the mega menu as a bento grid.
 * Headline is the company claim from the footer. Lists in src/i18n/offer.json.
 * Cards light up under the pointer (spotlight via --mx/--my, set in site.ts).
 */
import Icon from '../ui/Icon.astro';
import Blobs from '../ui/Blobs.astro';
import { pick, dict, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
import chrome from '../../i18n/chrome.json';
import offer from '../../i18n/offer.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data, lang) as Record<string, any>;
const c = dict(chrome, lang);
const o = pick(offer, lang);
// Second sentence of the footer claim: "Wir planen und realisieren Lösungen, ..."
const claim = c.f_claim.split(/(?<=[.!])\s+/).slice(1).join(' ');
---

<section class="jx-section jx-port" id="leistungen">
  <Blobs
    blobs={[
      { x: '-14%', y: '-20%', size: 'min(56vw, 760px)', g: 'royal', o: 0.45, soft: true, d: 26, depth: 30 },
      { x: '70%', y: '50%', size: 'min(44vw, 600px)', g: 'green', o: 0.22, soft: true, d: 30, delay: 9, depth: 40 },
    ]}
  />
  <div class="jx-port__grid-bg" aria-hidden="true"></div>
  <div class="jx-wrap jx-port__wrap">
    <header class="jx-head">
      <div>
        <span class="jx-kicker jx-kicker--light" data-reveal>{t.port_kicker}</span>
        <h2 class="jx-h2" data-reveal style="--i:1">{claim}</h2>
      </div>
    </header>

    <div class="jx-bento" data-spotlight>
      <div class="jx-bento__services">
        <p class="jx-bento__label" data-reveal><span class="jx-tag">{t.port_services}</span></p>
        <ul>
          {
            o.services.map((s, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a class="jx-card" href={s.href}>
                  <span class="jx-card__ico">
                    <Icon name={s.key as any} size={22} />
                  </span>
                  <strong>{s.name}</strong>
                  <span class="jx-card__desc">{s.desc}</span>
                  <span class="jx-card__go" aria-hidden="true">
                    <Icon name="arrow" size={18} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="jx-bento__products">
        <p class="jx-bento__label" data-reveal><span class="jx-tag jx-tag--green">{t.port_products}</span></p>
        <ul>
          {
            o.products.map((p, i) => (
              <li data-reveal style={`--i:${i + 2}`}>
                <a class="jx-card jx-card--product" href={p.href}>
                  <img src={p.icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  <span>
                    <strong>{p.name}</strong>
                    <span class="jx-card__desc">{p.desc}</span>
                  </span>
                  <span class="jx-card__go" aria-hidden="true">
                    <Icon name="arrow" size={18} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .jx-port {
    isolation: isolate;
    overflow: hidden;
    background: var(--jx-night);
    color: #fff;
  }
  .jx-port .jx-blobs {
    z-index: -1;
  }
  .jx-port__grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 80%);
  }
  .jx-port .jx-h2 {
    max-width: 22ch;
  }
  .jx-bento {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
  }
  .jx-bento ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .jx-bento__services ul {
    grid-template-columns: 1fr 1fr;
  }
  .jx-bento__label {
    margin-bottom: 14px;
  }
  .jx-card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    height: 100%;
    min-height: 168px;
    padding: 24px 24px 26px;
    border-radius: 20px;
    background:
      radial-gradient(420px circle at var(--mx) var(--my), rgba(63, 198, 242, 0.14), transparent 45%),
      rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    transition:
      border-color var(--jx-med) var(--jx-ease),
      translate var(--jx-med) var(--jx-ease),
      background-color var(--jx-med);
  }
  .jx-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgba(86, 198, 87, 0.8), rgba(14, 120, 177, 0.6) 40%, transparent 70%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--jx-med);
  }
  .jx-card:hover {
    translate: 0 -4px;
    border-color: rgba(255, 255, 255, 0.16);
  }
  .jx-card:hover::before {
    opacity: 1;
  }
  .jx-card__ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 12px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(140deg, var(--jx-blue), #1ab8e8);
    box-shadow: 0 10px 24px rgba(14, 120, 177, 0.35);
    transition: rotate var(--jx-med) var(--jx-ease);
  }
  .jx-card:hover .jx-card__ico {
    rotate: -8deg;
  }
  .jx-card strong {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .jx-card__desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.64);
    max-width: 34ch;
  }
  .jx-card__go {
    position: absolute;
    right: 20px;
    top: 22px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    rotate: -45deg;
    transition:
      rotate var(--jx-med) var(--jx-ease),
      background-color var(--jx-med),
      border-color var(--jx-med);
  }
  .jx-card:hover .jx-card__go {
    rotate: 0deg;
    background: var(--jx-blue);
    border-color: var(--jx-blue);
  }
  .jx-card--product {
    grid-template-columns: 56px 1fr;
    align-items: center;
    align-content: center;
    gap: 16px;
    min-height: 0;
    padding: 20px 64px 20px 20px;
  }
  .jx-card--product img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    padding: 8px;
    border-radius: 16px;
    background: #fff;
  }
  .jx-card--product strong {
    display: block;
    margin-bottom: 4px;
  }
  .jx-card--product .jx-card__go {
    top: 50%;
    margin-top: -17px;
  }
  .jx-card--product:hover .jx-card__go {
    background: var(--jx-green);
    border-color: var(--jx-green);
  }
  .jx-bento__products ul {
    height: calc(100% - 44px);
    grid-auto-rows: 1fr;
  }
  @media (max-width: 1024px) {
    .jx-bento {
      grid-template-columns: 1fr;
    }
    .jx-bento__products ul {
      height: auto;
    }
  }
  @media (max-width: 640px) {
    .jx-bento__services ul {
      grid-template-columns: 1fr;
    }
    .jx-card {
      min-height: 0;
    }
  }
</style>
