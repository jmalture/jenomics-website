---
/**
 * Section "hero": Make IT possible!
 * Texts: src/i18n/home.json, keys "hero_*". The baked blobs of the old hero PNG are now live
 * (Blobs component) behind a clean crop of the same photo.
 */
import Icon from '../ui/Icon.astro';
import Blobs from '../ui/Blobs.astro';
import HeroSlider from './hero-slider.astro';
import { pick, fill, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data, lang) as Record<string, any>;
const ring = fill(t.hero_ring);
---

<section class="jx-hero" id="start">
  <Blobs
    class="jx-hero__bg"
    blobs={[
      { x: '62%', y: '-18%', size: 'min(52vw, 720px)', g: 'blue', o: 0.16, soft: true, d: 24, depth: 30 },
      { x: '-12%', y: '22%', size: 'min(40vw, 520px)', g: 'green', o: 0.12, soft: true, d: 28, delay: 6, depth: 24 },
    ]}
  />
  <div class="jx-wrap jx-hero__grid">
    <div class="jx-hero__copy">
      <p class="jx-hero__badge" data-reveal style="--i:0">
        <span class="jx-hero__dot" aria-hidden="true"></span>
        {fill(t.hero_badge)}
      </p>
      <h1 class="jx-hero__title" aria-label={`${t.hero_title_a} ${t.hero_title_b} ${t.hero_title_c}`}>
        <span class="jx-hero__line" aria-hidden="true"><span style="--i:1">{t.hero_title_a}</span> <span class="jx-hero__it" style="--i:2">{t.hero_title_b}</span></span>
        <span class="jx-hero__line" aria-hidden="true"><span style="--i:3">{t.hero_title_c}</span></span>
      </h1>
      <p class="jx-hero__lead" data-reveal style="--i:4">{t.hero_lead}</p>
      <p class="jx-hero__text" data-reveal style="--i:5">{t.hero_text} <strong>{t.hero_text_b}</strong></p>
      <div class="jx-hero__ctas" data-reveal style="--i:6">
        <a class="jx-btn" href={t.hero_cta_href}>{t.hero_cta}<Icon name="arrow" /></a>
        <a class="jx-btn jx-btn--ghost" href="#loesungen">{t.hero_cta2}</a>
      </div>
    </div>

    <div class="jx-hero__visual" data-tilt>
      <Blobs
        class="jx-hero__blobs"
        blobs={[
          { x: '38%', y: '-14%', size: '74%', g: 'green', d: 16, dx: '4%', dy: '6%', depth: 26 },
          { x: '-12%', y: '30%', size: '46%', g: 'blue', d: 19, delay: 5, dx: '-5%', dy: '4%', depth: 40 },
          { x: '64%', y: '64%', size: '30%', g: 'royal', d: 14, delay: 3, dx: '6%', dy: '-6%', depth: 54 },
        ]}
      />
      <div class="jx-hero__frame">
        <HeroSlider lang={lang} />
      </div>
      <div class="jx-hero__pill jx-hero__pill--a" data-reveal="right" style="--i:5">
        <span class="jx-pill"><i><Icon name="calendar" /></i>{fill(t.hero_pill_since)}</span>
      </div>
      <div class="jx-hero__ring" data-reveal="scale" style="--i:8" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <defs><path id="jx-ring-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
          <text><textPath href="#jx-ring-path" textLength="488">{ring}</textPath></text>
        </svg>
        <img src="/media/jenomics-signet.png" alt="" width="64" height="64" />
      </div>
    </div>
  </div>
  <a class="jx-hero__scroll" href="#loesungen" aria-label={t.hero_scroll}><span></span></a>
</section>

<style is:global>
  .jx-hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--jx-header-h) * -1);
    padding-top: calc(var(--jx-header-h) + clamp(32px, 6vw, 88px));
    padding-bottom: clamp(56px, 7vw, 110px);
    background: linear-gradient(180deg, #f2f8fc 0%, #fff 78%);
    overflow: hidden;
  }
  .jx-hero__bg {
    z-index: -1;
  }
  .jx-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }
  .jx-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(14, 120, 177, 0.16);
    box-shadow: var(--jx-shadow-sm);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--jx-navy);
  }
  .jx-hero__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--jx-green);
  }
  .jx-hero__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--jx-green);
    animation: jx-ping 2.4s var(--jx-ease) infinite;
  }
  @keyframes jx-ping {
    0% {
      opacity: 0.8;
      scale: 0.6;
    }
    80%,
    100% {
      opacity: 0;
      scale: 1.8;
    }
  }
  .jx-hero__title {
    margin: 22px 0 26px;
    font-size: var(--jx-h1);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--jx-blue);
  }
  .jx-hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .jx-hero__line > span {
    display: inline-block;
  }
  .js .jx-hero__line > span {
    translate: 0 105%;
    animation: jx-rise 1.1s var(--jx-ease) forwards;
    animation-delay: calc(var(--i) * 110ms + 120ms);
  }
  @keyframes jx-rise {
    to {
      translate: 0 0;
    }
  }
  .jx-hero__it {
    background: linear-gradient(100deg, var(--jx-blue) 0%, #1ab8e8 35%, #20d3a6 62%, var(--jx-green) 80%, var(--jx-blue) 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: jx-shimmer 9s ease-in-out infinite alternate;
  }
  .js .jx-hero__it {
    animation:
      jx-rise 1.1s var(--jx-ease) forwards calc(var(--i) * 110ms + 120ms),
      jx-shimmer 9s ease-in-out infinite alternate 1.4s;
  }
  @keyframes jx-shimmer {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }
  .jx-hero__lead {
    font-size: var(--jx-lead);
    font-weight: 600;
    line-height: 1.45;
    color: var(--jx-ink);
    max-width: 30ch;
  }
  .jx-hero__text {
    margin-top: 14px;
    max-width: 46ch;
    color: var(--jx-grey);
    font-size: 1.0625rem;
  }
  .jx-hero__text strong {
    color: var(--jx-ink);
    font-weight: 500;
  }
  .jx-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  /* Visual */
  .jx-hero__visual {
    position: relative;
    padding: 6% 4% 8% 6%;
    --rx: 0;
    --ry: 0;
  }
  .jx-hero__blobs {
    inset: 0;
  }
  .jx-hero__frame {
    position: relative;
    margin: 0;
    padding: 10px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(6px);
    box-shadow:
      var(--jx-shadow-lg),
      inset 0 0 0 1px rgba(255, 255, 255, 0.9);
    transform: perspective(1200px) rotateX(calc(var(--ry) * -3deg)) rotateY(calc(var(--rx) * 4deg));
    transition: transform 1s var(--jx-ease);
    animation: jx-frame-in 1.3s var(--jx-ease) both 0.2s;
  }
  @keyframes jx-frame-in {
    from {
      clip-path: inset(8% 8% 8% 8% round 26px);
      scale: 0.94;
    }
    to {
      clip-path: inset(-30% -30% -30% -30% round 26px);
      scale: 1;
    }
  }
  .jx-hero__pill {
    position: absolute;
    z-index: 2;
  }
  .jx-hero__pill .jx-pill {
    animation: jx-float 7s ease-in-out infinite;
  }
  .jx-hero__pill--a {
    top: 2%;
    left: -2%;
  }
  @keyframes jx-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }
  .jx-hero__ring {
    position: absolute;
    z-index: 2;
    right: 2%;
    bottom: -2%;
    width: clamp(104px, 10.5vw, 140px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--jx-shadow);
  }
  .jx-hero__ring svg {
    position: absolute;
    inset: 0;
    animation: jx-spin 28s linear infinite;
  }
  .jx-hero__ring text {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--jx-navy);
  }
  .jx-hero__ring img {
    position: relative;
    width: 56%;
  }
  @keyframes jx-spin {
    to {
      rotate: 360deg;
    }
  }
  .jx-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border-radius: 14px;
    border: 2px solid rgba(30, 61, 126, 0.25);
  }
  .jx-hero__scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--jx-blue);
    animation: jx-wheel 2s var(--jx-ease) infinite;
  }
  @keyframes jx-wheel {
    0% {
      opacity: 0;
      translate: 0 -4px;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 12px;
    }
  }

  @media (max-width: 960px) {
    .jx-hero__grid {
      grid-template-columns: 1fr;
    }
    .jx-hero__visual {
      max-width: 640px;
      width: 100%;
      margin-inline: auto;
    }
    .jx-hero__scroll {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .jx-hero__pill--a {
      left: 0;
      top: -2%;
    }
    .jx-hero__ring {
      right: 0;
      bottom: auto;
      top: -6%;
      width: 84px;
    }
    .jx-hero__ring text {
      font-size: 16px;
    }
    .jx-pill {
      font-size: 0.75rem;
    }
  }
</style>
