---
/**
 * Hero showcase: a 3D carousel of what Jenomics does (6 services + own products).
 *
 * - The cards stand on a ring in 3D space; the whole ring turns to bring the next card to the front
 *   (side cards stay visible, angled and dimmed, so it reads as a filmstrip in depth).
 * - Every turn re-themes the hero: the live blobs and the background wash take the slide's palette
 *   (registered custom properties --hA/--hB/--hC, so the colours blend instead of jumping).
 * - A giant outlined word sweeps in behind the ring; the caption below swaps word by word.
 * - Autoplay with progress; pauses on hover/focus, off screen and in hidden tabs. Click a side card,
 *   arrows, drag/swipe or keyboard to turn. Reduced motion: no autoplay, no turning animation.
 *
 * Texts: offer.json (services/products) + home.json "hero_slider_*" / "hero_ghost_*".
 * The first card image is the page's LCP image (preloaded in Home.astro).
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
import offer from '../../i18n/offer.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data, lang) as Record<string, any>;
const o = pick(offer, lang);

type Slide = {
  key: string;
  kicker: string;
  title: string;
  desc: string;
  href: string;
  ghost: string;
  visual: 'img' | 'terminal' | 'network' | 'products';
  img?: string;
  pal: [string, string, string]; // blob palette A, B, C
};
const svc = (k: string) => o.services.find((s) => s.key === k)!;
const def: [string, Slide['visual'], string | undefined, Slide['pal']][] = [
  ['it', 'img', 'service-it-admin', ['#1a8fe0', '#3fc6f2', '#2ee59d']],
  ['dev', 'img', 'service-dev', ['#2a3bc8', '#1a6fe0', '#29a8ef']],
  ['web', 'img', 'service-web', ['#20d3c2', '#2ee59d', '#1ab8e8']],
  ['linux', 'terminal', undefined, ['#1e3d7e', '#0e78b1', '#3fc6f2']],
  ['net', 'network', undefined, ['#0e78b1', '#20d3c2', '#56c657']],
  ['host', 'img', 'hero-landscape', ['#56c657', '#2ee59d', '#20d3c2']],
];
const slides: Slide[] = def.map(([k, visual, img, pal], i) => ({
  key: k,
  kicker: `${t.hero_slider_service} ${String(i + 1).padStart(2, '0')}`,
  title: svc(k).name,
  desc: svc(k).desc,
  href: svc(k).href,
  ghost: t[`hero_ghost_${k}`],
  visual,
  img,
  pal,
}));
slides.push({
  key: 'products',
  kicker: t.hero_slider_products,
  title: t.hero_slider_products_title,
  desc: o.products.map((p) => p.name).join(' · '),
  href: t.hero_slider_products_href,
  ghost: t.hero_ghost_products,
  visual: 'products',
  pal: ['#2a3bc8', '#29a8ef', '#2ee59d'],
});
const n = slides.length;
const pad = (x: number) => String(x).padStart(2, '0');
const terminal = [
  ['$', 'ssh admin@srv-01'],
  ['$', 'apt upgrade -y'],
  ['✓', t.hero_slider_term_ok],
  ['$', 'ansible-playbook rollout.yml'],
  ['✓', 'failed=0'],
];
const nodes = [
  { x: 92, y: 80 },
  { x: 508, y: 72 },
  { x: 548, y: 236 },
  { x: 404, y: 330 },
  { x: 150, y: 318 },
  { x: 52, y: 206 },
];
---

<div
  class="jx-show"
  data-show
  style={`--n:${n}`}
  data-palettes={JSON.stringify(slides.map((s) => s.pal))}
  aria-roledescription="carousel"
  aria-label={t.hero_slider_label}
>
  <div class="jx-show__ghost" aria-hidden="true">
    {slides.map((s, i) => <span class:list={{ 'is-active': i === 0 }}>{s.ghost}</span>)}
  </div>

  <div class="jx-show__scene">
    <span class="jx-show__floor" aria-hidden="true"></span>
    <div class="jx-show__ring" style="--rot:0">
      {
        slides.map((s, i) => (
          <a
            class:list={['jx-c3', `jx-c3--${s.visual}`, { 'is-active': i === 0 }]}
            href={s.href}
            style={`--i:${i}`}
            data-index={i}
            aria-label={`${i + 1} / ${n}: ${s.title}`}
            tabindex={i === 0 ? undefined : -1}
            draggable="false"
          >
            <span class="jx-c3__media" aria-hidden="true">
              {s.visual === 'img' && (
                <picture>
                  <source media="(max-width: 700px)" srcset={`/media/${s.img}-720.webp`} />
                  <img
                    src={`/media/${s.img}-1200.webp`}
                    alt=""
                    width="1200"
                    height="776"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding="async"
                    draggable="false"
                  />
                </picture>
              )}
              {s.key === 'host' && (
                <span class="jx-c3__badge">
                  <Icon name="leaf" size={14} />
                  {t.hero_pill_green}
                </span>
              )}
              {s.visual === 'terminal' && (
                <span class="jx-term">
                  <span class="jx-term__bar">
                    <i />
                    <i />
                    <i />
                  </span>
                  {terminal.map(([p, line], k) => (
                    <span class:list={['jx-term__ln', { 'is-ok': p !== '$' }]} style={`--k:${k}`}>
                      <b>{p}</b> {line}
                    </span>
                  ))}
                  <span class="jx-term__ln" style={`--k:${terminal.length}`}>
                    <b>$</b> <span class="jx-term__cursor" />
                  </span>
                </span>
              )}
              {s.visual === 'network' && (
                <svg class="jx-net" viewBox="0 0 600 388" preserveAspectRatio="xMidYMid slice">
                  {nodes.map((p, k) => (
                    <g style={`--k:${k}`}>
                      <line class="jx-net__base" x1="300" y1="194" x2={p.x} y2={p.y} />
                      <line class="jx-net__pulse" x1="300" y1="194" x2={p.x} y2={p.y} />
                      <circle class="jx-net__node" cx={p.x} cy={p.y} r="18" />
                    </g>
                  ))}
                  <circle class="jx-net__hub" cx="300" cy="194" r="48" />
                  <image href="/media/jenomics-signet.png" x="268" y="162" width="64" height="64" />
                </svg>
              )}
              {s.visual === 'products' && (
                <span class="jx-prods">
                  {o.products.map((p, k) => (
                    <span class="jx-prods__card" style={`--k:${k}`}>
                      <img src={p.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
                    </span>
                  ))}
                </span>
              )}
            </span>
            <span class="jx-c3__num" aria-hidden="true">
              {pad(i + 1)}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="jx-show__caps" aria-live="polite">
    {
      slides.map((s, i) => (
        <div class:list={['jx-show__cap', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <span class="jx-show__kicker">
            <span>{s.kicker}</span>
          </span>
          <p class="jx-show__title">
            {s.title.split(' ').map((w, k) => (
              <span class="jx-show__w">
                <span style={`--k:${k}`}>{w}</span>
              </span>
            ))}
          </p>
          <p class="jx-show__desc">
            <span>{s.desc}</span>
          </p>
          <a class="jx-show__more" href={s.href} tabindex={i === 0 ? undefined : -1}>
            <span>
              {t.hero_slider_more}
              <Icon name="arrow" size={16} />
            </span>
          </a>
        </div>
      ))
    }
  </div>

  <div class="jx-show__nav">
    <button class="jx-show__btn" data-prev aria-label={t.hero_slider_prev}>
      <Icon name="left" size={18} />
    </button>
    <span class="jx-show__count" aria-hidden="true"><b data-cur>01</b> / {pad(n)}</span>
    <span class="jx-show__bar" aria-hidden="true"><i></i></span>
    <button class="jx-show__btn" data-next aria-label={t.hero_slider_next}>
      <Icon name="right" size={18} />
    </button>
  </div>
</div>

<style is:global>
  /* Palette channels: registered so they interpolate when a slide re-themes the hero */
  @property --hA {
    syntax: '<color>';
    inherits: true;
    initial-value: #1a8fe0;
  }
  @property --hB {
    syntax: '<color>';
    inherits: true;
    initial-value: #3fc6f2;
  }
  @property --hC {
    syntax: '<color>';
    inherits: true;
    initial-value: #2ee59d;
  }
  .jx-hero {
    transition:
      --hA 1.6s var(--jx-ease-io),
      --hB 1.6s var(--jx-ease-io),
      --hC 1.6s var(--jx-ease-io);
  }

  .jx-show {
    isolation: isolate;
    --cw: clamp(210px, 22vw, 318px); /* card width */
    --ch: calc(var(--cw) * 0.7); /* card height */
    --step: calc(360deg / var(--n));
    --r: calc(var(--cw) / 2 / tan(180deg / var(--n)) * 1.14); /* ring radius, 14% air between cards */
    position: relative;
    user-select: none;
  }

  /* Giant outlined word behind the ring */
  .jx-show__ghost {
    position: absolute;
    left: -10%;
    right: -12%;
    top: calc(var(--ch) + 40px);
    height: clamp(120px, 14vw, 190px);
    display: grid;
    place-items: center end;
    pointer-events: none;
    overflow: hidden;
    z-index: -1;
    mask-image: linear-gradient(90deg, transparent, #000 16%, #000 90%, transparent);
  }
  .jx-show__ghost span {
    grid-area: 1 / 1;
    font-size: clamp(4rem, 2rem + 7.5vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: color-mix(in srgb, var(--hA) 6%, transparent);
    -webkit-text-stroke: 1.2px color-mix(in srgb, var(--hA) 28%, transparent);
    opacity: 0;
    translate: 40% 0;
    skew: -12deg 0;
    transition:
      opacity 0.9s var(--jx-ease),
      translate 1.4s var(--jx-ease-io),
      skew 1.4s var(--jx-ease-io);
  }
  .jx-show__ghost span.is-active {
    opacity: 1;
    translate: 0 0;
    skew: 0deg 0;
  }
  .jx-show__ghost span.is-out {
    opacity: 0;
    translate: -40% 0;
    skew: 12deg 0;
  }

  /* 3D ring */
  .jx-show__scene {
    position: relative;
    height: calc(var(--ch) + 70px);
    perspective: 1500px;
    perspective-origin: 50% 40%;
    touch-action: pan-y;
    cursor: grab;
  }
  .jx-show__floor {
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: calc(var(--cw) * 1.9);
    height: 46px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--hA) 45%, #0b1a36 40%), transparent);
    opacity: 0.45;
    filter: blur(8px);
  }
  .jx-show__scene.is-dragging {
    cursor: grabbing;
  }
  .jx-show__ring {
    position: absolute;
    left: 50%;
    top: 35px;
    width: var(--cw);
    height: var(--ch);
    margin-left: calc(var(--cw) / -2);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1)) rotateX(calc(var(--ry, 0) * -5deg - 4deg))
      rotateY(calc(var(--rot) * -1 * var(--step) + var(--drag, 0deg)));
    transition: transform 1.35s cubic-bezier(0.7, 0, 0.18, 1);
  }
  .jx-show__scene.is-dragging .jx-show__ring {
    transition: none;
  }
  .jx-c3 {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 18px;
    overflow: hidden;
    background: var(--jx-night);
    transform: rotateY(calc(var(--i) * var(--step))) translateZ(var(--r));
    backface-visibility: hidden;
    /* no box-shadow on 3D cards: Chrome clips it to the 3D layer and draws a pale box; the floor
       shadow (.jx-show__floor) gives the depth instead */
    outline: 1px solid rgba(255, 255, 255, 0.35);
    outline-offset: -1px;
    filter: brightness(var(--b, 0.55)) saturate(var(--s, 0.7));
    opacity: var(--o, 1);
    transition:
      filter 1.2s var(--jx-ease),
      opacity 1.2s var(--jx-ease),
      outline-color 1.2s var(--jx-ease);
    -webkit-user-drag: none;
  }
  .jx-c3[data-dist='0'] {
    --b: 1;
    --s: 1;
    outline: 4px solid color-mix(in srgb, var(--hB) 55%, white);
    outline-offset: -4px;
  }
  .jx-c3[data-dist='1'] {
    --b: 0.72;
    --s: 0.85;
  }
  .jx-c3[data-dist='2'] {
    --o: 0.45;
  }
  .jx-c3[data-dist='3'] {
    --o: 0.12;
  }
  .jx-c3__media {
    position: absolute;
    inset: 0;
    display: block;
    container-type: inline-size;
  }
  .jx-c3__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.12;
    transition: scale 6s cubic-bezier(0.25, 0.4, 0.3, 1);
  }
  .jx-c3.is-active .jx-c3__media img {
    scale: 1;
  }
  .jx-c3__num {
    position: absolute;
    top: 12px;
    left: 14px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(11, 26, 54, 0.5);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .jx-c3__badge {
    position: absolute;
    right: 12px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--jx-green);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 500;
  }

  /* Card visual: terminal */
  .jx-term {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 2.2cqw;
    padding: 13cqw 7cqw 6cqw;
    background:
      radial-gradient(circle at 85% 10%, rgba(26, 143, 224, 0.45), transparent 50%),
      linear-gradient(160deg, #081429, #10264d);
    color: #d9e6f2;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 4.2cqw;
  }
  .jx-term__bar {
    position: absolute;
    top: 5cqw;
    right: 6cqw;
    display: flex;
    gap: 1.6cqw;
  }
  .jx-term__bar i {
    width: 2.4cqw;
    height: 2.4cqw;
    border-radius: 50%;
    background: #ff5f57;
  }
  .jx-term__bar i:nth-child(2) {
    background: #febc2e;
  }
  .jx-term__bar i:nth-child(3) {
    background: #28c840;
  }
  .jx-term__ln {
    white-space: nowrap;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
  }
  .jx-term b {
    color: #3fc6f2;
  }
  .jx-term__ln.is-ok,
  .jx-term__ln.is-ok b {
    color: #7be495;
  }
  .jx-c3.is-active .jx-term__ln {
    animation: jx-type 0.5s steps(20, end) forwards;
    animation-delay: calc(0.9s + var(--k) * 0.45s);
  }
  .jx-c3:not(.is-active) .jx-term__ln {
    clip-path: inset(0 0 0 0);
  }
  @keyframes jx-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .jx-term__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    vertical-align: -2px;
    background: #3fc6f2;
    animation: jx-blink 1s steps(2) infinite;
  }
  @keyframes jx-blink {
    50% {
      opacity: 0;
    }
  }

  /* Card visual: network */
  .jx-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 50%, rgba(46, 229, 157, 0.22), transparent 55%),
      linear-gradient(150deg, #0b1a36, #13306a);
  }
  .jx-net__base {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 2.5;
  }
  .jx-net__pulse {
    stroke: #2ee59d;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 16 300;
    stroke-dashoffset: 316;
  }
  .jx-c3.is-active .jx-net__pulse {
    animation: jx-pulse 2.2s linear infinite;
    animation-delay: calc(var(--k) * 0.35s);
  }
  @keyframes jx-pulse {
    to {
      stroke-dashoffset: 0;
    }
  }
  .jx-net__node {
    fill: #10264d;
    stroke: #3fc6f2;
    stroke-width: 3;
  }
  .jx-net__hub {
    fill: #fff;
    filter: drop-shadow(0 0 24px rgba(46, 229, 157, 0.7));
  }

  /* Card visual: products */
  .jx-prods {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5cqw;
    background:
      radial-gradient(circle at 20% 15%, rgba(46, 229, 157, 0.4), transparent 45%),
      var(--jx-blob-royal);
  }
  .jx-prods__card {
    display: grid;
    place-items: center;
    width: 22cqw;
    aspect-ratio: 1;
    border-radius: 6cqw;
    background: #fff;
    box-shadow: 0 4cqw 8cqw rgba(5, 20, 60, 0.3);
  }
  .jx-prods__card img {
    width: 66%;
  }
  .jx-c3.is-active .jx-prods__card {
    animation: jx-float 5s ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.6s);
  }

  /* Caption: swaps word by word */
  .jx-show__caps {
    display: grid;
    margin-top: 6px;
    padding-inline: 4px;
  }
  .jx-show__cap {
    grid-area: 1 / 1;
    display: grid;
    justify-items: start;
    gap: 6px;
    pointer-events: none;
  }
  .jx-show__cap.is-active {
    pointer-events: auto;
  }
  .jx-show__kicker,
  .jx-show__desc,
  .jx-show__more,
  .jx-show__w {
    display: block;
    overflow: hidden;
  }
  .jx-show__kicker > span,
  .jx-show__desc > span,
  .jx-show__more > span,
  .jx-show__w > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    translate: 0 110%;
    transition: translate 0.55s var(--jx-ease);
  }
  .jx-show__cap.is-active .jx-show__kicker > span,
  .jx-show__cap.is-active .jx-show__desc > span,
  .jx-show__cap.is-active .jx-show__more > span,
  .jx-show__cap.is-active .jx-show__w > span {
    translate: 0 0;
    transition-duration: 0.9s;
  }
  .jx-show__cap.is-active .jx-show__kicker > span {
    transition-delay: 0.35s;
  }
  .jx-show__cap.is-active .jx-show__w > span {
    transition-delay: calc(0.45s + var(--k) * 0.07s);
  }
  .jx-show__cap.is-active .jx-show__desc > span {
    transition-delay: 0.7s;
  }
  .jx-show__cap.is-active .jx-show__more > span {
    transition-delay: 0.8s;
  }
  .jx-show__cap:not(.is-active) span > span,
  .jx-show__cap:not(.is-active) .jx-show__kicker > span,
  .jx-show__cap:not(.is-active) .jx-show__desc > span,
  .jx-show__cap:not(.is-active) .jx-show__more > span {
    translate: 0 -110%;
  }
  .jx-show__cap.is-next span > span,
  .jx-show__cap.is-next .jx-show__kicker > span,
  .jx-show__cap.is-next .jx-show__desc > span,
  .jx-show__cap.is-next .jx-show__more > span {
    transition: none;
    translate: 0 110%;
  }
  .jx-show__kicker > span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--hA) 80%, #0b1a36);
  }
  .jx-show__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .jx-show__desc {
    max-width: 44ch;
    color: var(--jx-grey);
    font-size: 0.9375rem;
  }
  .jx-show__more {
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--jx-blue);
    text-decoration: none;
  }
  .jx-show__more svg {
    transition: translate var(--jx-fast) var(--jx-ease);
  }
  .jx-show__more:hover svg {
    translate: 4px 0;
  }

  /* Nav: arrows, counter, progress */
  .jx-show__nav {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding-inline: 4px;
  }
  .jx-show__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #d6dde4;
    background: #fff;
    cursor: pointer;
    transition:
      background-color var(--jx-fast),
      color var(--jx-fast),
      border-color var(--jx-fast);
  }
  .jx-show__btn:hover {
    background: var(--jx-blue);
    border-color: var(--jx-blue);
    color: #fff;
  }
  .jx-show__count {
    font-size: 0.875rem;
    color: var(--jx-grey);
    font-variant-numeric: tabular-nums;
  }
  .jx-show__count b {
    color: var(--jx-ink);
    font-weight: 600;
  }
  .jx-show__bar {
    flex: 1;
    max-width: 220px;
    height: 3px;
    border-radius: 3px;
    background: rgba(30, 61, 126, 0.12);
    overflow: hidden;
  }
  .jx-show__bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--hA), var(--hC));
    transform: scaleX(0);
    transform-origin: left;
  }
  .jx-show.is-auto .jx-show__bar i {
    animation: jx-prog var(--slide-time, 5.5s) linear forwards;
  }
  .jx-show.is-hold .jx-show__bar i {
    animation-play-state: paused;
  }

  @media (max-width: 960px) {
    .jx-show {
      --cw: clamp(200px, 46vw, 300px);
    }
  }
  @media (max-width: 560px) {
    .jx-show {
      --cw: 58vw;
    }
    .jx-show__desc {
      font-size: 0.875rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jx-show__ring {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-show]').forEach((root) => {
    const scene = root.querySelector<HTMLElement>('.jx-show__scene')!;
    const ring = root.querySelector<HTMLElement>('.jx-show__ring')!;
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('.jx-c3')];
    const caps = [...root.querySelectorAll<HTMLElement>('.jx-show__cap')];
    const ghosts = [...root.querySelectorAll<HTMLElement>('.jx-show__ghost span')];
    const cur = root.querySelector('[data-cur]')!;
    const theme = (root.closest('.jx-hero') as HTMLElement) ?? root;
    const pals: [string, string, string][] = JSON.parse(root.dataset.palettes || '[]');
    const n = cards.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TIME = 5500;
    let pos = 0; // unbounded ring position (so the ring always turns the short way)
    let timer = 0;
    let inView = true;
    const mod = (x: number) => ((x % n) + n) % n;
    const pad = (x: number) => String(x).padStart(2, '0');

    const paint = () => {
      const idx = mod(pos);
      ring.style.setProperty('--rot', String(pos));
      cards.forEach((c, k) => {
        let d = Math.abs(k - idx);
        d = Math.min(d, n - d);
        c.dataset.dist = String(Math.min(d, 3));
        c.classList.toggle('is-active', k === idx);
        c.tabIndex = k === idx ? 0 : -1;
      });
      caps.forEach((c, k) => {
        const on = k === idx;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-hidden', on ? 'false' : 'true');
        c.querySelector('a')!.tabIndex = on ? 0 : -1;
      });
      const [a, b, cc] = pals[idx] ?? [];
      if (a) {
        theme.style.setProperty('--hA', a);
        theme.style.setProperty('--hB', b);
        theme.style.setProperty('--hC', cc);
      }
      cur.textContent = pad(idx + 1);
    };

    const go = (target: number) => {
      if (target === pos) return schedule();
      const prevIdx = mod(pos);
      const nextIdx = mod(target);
      // ghost word: old sweeps out, new sweeps in
      ghosts.forEach((g, k) => {
        g.classList.toggle('is-out', k === prevIdx);
        g.classList.toggle('is-active', k === nextIdx);
      });
      // caption: the incoming one starts below, the outgoing leaves upwards
      const inc = caps[nextIdx];
      inc.classList.add('is-next');
      void inc.offsetWidth;
      inc.classList.remove('is-next');
      pos = target;
      paint();
      schedule();
    };
    const step = (dir: number) => go(pos + dir);
    const toIndex = (k: number) => {
      let d = k - mod(pos);
      if (d > n / 2) d -= n;
      if (d < -n / 2) d += n;
      go(pos + d);
    };

    const schedule = () => {
      clearTimeout(timer);
      root.classList.remove('is-auto');
      if (reduce) return;
      void root.offsetWidth;
      root.style.setProperty('--slide-time', `${TIME}ms`);
      root.classList.add('is-auto');
      timer = window.setTimeout(tick, TIME);
    };
    const tick = () => {
      if (root.classList.contains('is-hold') || !inView || document.hidden) {
        timer = window.setTimeout(tick, 500);
        return;
      }
      step(1);
    };

    // side cards turn the ring; the front card follows its link
    let dragged = false;
    cards.forEach((c, k) =>
      c.addEventListener('click', (e) => {
        if (dragged || k !== mod(pos)) {
          e.preventDefault();
          if (!dragged) toIndex(k);
        }
      }),
    );
    root.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
    root.addEventListener('pointerenter', () => root.classList.add('is-hold'));
    root.addEventListener('pointerleave', () => root.classList.remove('is-hold'));
    root.addEventListener('focusin', () => root.classList.add('is-hold'));
    root.addEventListener('focusout', () => root.classList.remove('is-hold'));

    // drag / swipe: the ring follows the pointer, then snaps to the nearest card
    let x0: number | null = null;
    let dx = 0;
    scene.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      dx = 0;
      dragged = false;
    });
    addEventListener('pointermove', (e) => {
      if (x0 === null) return;
      dx = e.clientX - x0;
      if (!dragged && Math.abs(dx) > 6) {
        dragged = true;
        scene.classList.add('is-dragging');
      }
      if (dragged) ring.style.setProperty('--drag', `${dx * 0.18}deg`);
    });
    addEventListener('pointerup', () => {
      if (x0 === null) return;
      x0 = null;
      scene.classList.remove('is-dragging');
      ring.style.setProperty('--drag', '0deg');
      if (dragged) {
        const stepDeg = 360 / n;
        const turns = Math.round((-dx * 0.18) / stepDeg) || (dx < 0 ? 1 : -1);
        go(pos + turns);
        window.setTimeout(() => (dragged = false), 50);
      }
    });

    new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.3 }).observe(root);
    paint();
    schedule();
  });
</script>
