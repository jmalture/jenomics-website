---
/**
 * Hero showcase: one screen per thing Jenomics does (6 services + own products) that cross-fades
 * to the next. Kept quiet on text: each screen only carries a small label with number and name.
 *
 * - Screens fade through with a slight zoom and blur (cinematic cross-fade), the active one zooms
 *   slowly (Ken Burns); designed screens animate (terminal types, network pulses, products float).
 * - Every change re-themes the hero: the live blobs and the background wash take the screen's palette
 *   (registered custom properties --hA/--hB/--hC, so the colours blend instead of jumping).
 * - Autoplay with progress; pauses on hover/focus, off screen and in hidden tabs. Arrows, swipe and
 *   keyboard. Reduced motion: no autoplay.
 *
 * Texts: offer.json (services/products) + home.json "hero_slider_*".
 * The first card image is the page's LCP image (preloaded in Home.astro).
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
import offer from '../../i18n/offer.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data, lang) as Record<string, any>;
const o = pick(offer, lang);

type Slide = {
  key: string;
  kicker: string;
  title: string;
  desc: string;
  href: string;
  visual: 'img' | 'terminal' | 'network' | 'products';
  img?: string;
  pal: [string, string, string]; // blob palette A, B, C
};
const svc = (k: string) => o.services.find((s) => s.key === k)!;
const def: [string, Slide['visual'], string | undefined, Slide['pal']][] = [
  ['it', 'img', 'service-it-admin', ['#1a8fe0', '#3fc6f2', '#2ee59d']],
  ['dev', 'img', 'service-dev', ['#2a3bc8', '#1a6fe0', '#29a8ef']],
  ['web', 'img', 'service-web', ['#20d3c2', '#2ee59d', '#1ab8e8']],
  ['linux', 'terminal', undefined, ['#1e3d7e', '#0e78b1', '#3fc6f2']],
  ['net', 'network', undefined, ['#0e78b1', '#20d3c2', '#56c657']],
  ['host', 'img', 'hero-landscape', ['#56c657', '#2ee59d', '#20d3c2']],
];
const slides: Slide[] = def.map(([k, visual, img, pal], i) => ({
  key: k,
  kicker: `${t.hero_slider_service} ${String(i + 1).padStart(2, '0')}`,
  title: svc(k).name,
  desc: svc(k).desc,
  href: svc(k).href,
  visual,
  img,
  pal,
}));
slides.push({
  key: 'products',
  kicker: t.hero_slider_products,
  title: t.hero_slider_products_title,
  desc: o.products.map((p) => p.name).join(' · '),
  href: t.hero_slider_products_href,
  visual: 'products',
  pal: ['#2a3bc8', '#29a8ef', '#2ee59d'],
});
const n = slides.length;
const pad = (x: number) => String(x).padStart(2, '0');
const terminal = [
  ['$', 'ssh admin@srv-01'],
  ['$', 'apt upgrade -y'],
  ['✓', t.hero_slider_term_ok],
  ['$', 'ansible-playbook rollout.yml'],
  ['✓', 'failed=0'],
];
const nodes = [
  { x: 92, y: 80 },
  { x: 508, y: 72 },
  { x: 548, y: 236 },
  { x: 404, y: 330 },
  { x: 150, y: 318 },
  { x: 52, y: 206 },
];
---

<div
  class="jx-show"
  data-show
  data-palettes={JSON.stringify(slides.map((s) => s.pal))}
  aria-roledescription="carousel"
  aria-label={t.hero_slider_label}
>
  <div class="jx-show__stage">
    {
      slides.map((s, i) => (
        <a
          class:list={['jx-c3', `jx-c3--${s.visual}`, { 'is-active': i === 0 }]}
          href={s.href}
          aria-label={`${i + 1} / ${n}: ${s.title}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          tabindex={i === 0 ? undefined : -1}
          draggable="false"
        >
          <span class="jx-c3__media" aria-hidden="true">
            {s.visual === 'img' && (
              <picture>
                <source media="(max-width: 700px)" srcset={`/media/${s.img}-720.webp`} />
                <img
                  src={`/media/${s.img}-1200.webp`}
                  alt=""
                  width="1200"
                  height="776"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  draggable="false"
                />
              </picture>
            )}
            {s.key === 'host' && (
              <span class="jx-c3__badge">
                <Icon name="leaf" size={14} />
                {t.hero_pill_green}
              </span>
            )}
            {s.visual === 'terminal' && (
              <span class="jx-term">
                <span class="jx-term__bar">
                  <i />
                  <i />
                  <i />
                </span>
                {terminal.map(([p, line], k) => (
                  <span class:list={['jx-term__ln', { 'is-ok': p !== '$' }]} style={`--k:${k}`}>
                    <b>{p}</b> {line}
                  </span>
                ))}
                <span class="jx-term__ln" style={`--k:${terminal.length}`}>
                  <b>$</b> <span class="jx-term__cursor" />
                </span>
              </span>
            )}
            {s.visual === 'network' && (
              <svg class="jx-net" viewBox="0 0 600 388" preserveAspectRatio="xMidYMid slice">
                {nodes.map((p, k) => (
                  <g style={`--k:${k}`}>
                    <line class="jx-net__base" x1="300" y1="194" x2={p.x} y2={p.y} />
                    <line class="jx-net__pulse" x1="300" y1="194" x2={p.x} y2={p.y} />
                    <circle class="jx-net__node" cx={p.x} cy={p.y} r="18" />
                  </g>
                ))}
                <circle class="jx-net__hub" cx="300" cy="194" r="48" />
                <image href="/media/jenomics-signet.png" x="268" y="162" width="64" height="64" />
              </svg>
            )}
            {s.visual === 'products' && (
              <span class="jx-prods">
                {o.products.map((p, k) => (
                  <span class="jx-prods__card" style={`--k:${k}`}>
                    <img src={p.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
                  </span>
                ))}
              </span>
            )}
          </span>
          <span class="jx-c3__label">
            <b>{pad(i + 1)}</b>
            {s.title}
            <Icon name="arrow" size={16} />
          </span>
        </a>
      ))
    }
  </div>

  <div class="jx-show__nav">
    <button class="jx-show__btn" data-prev aria-label={t.hero_slider_prev}>
      <Icon name="left" size={18} />
    </button>
    <span class="jx-show__count" aria-hidden="true"><b data-cur>01</b> / {pad(n)}</span>
    <span class="jx-show__bar" aria-hidden="true"><i></i></span>
    <button class="jx-show__btn" data-next aria-label={t.hero_slider_next}>
      <Icon name="right" size={18} />
    </button>
  </div>
</div>

<style is:global>
  /* Palette channels: registered so they interpolate when a slide re-themes the hero */
  @property --hA {
    syntax: '<color>';
    inherits: true;
    initial-value: #1a8fe0;
  }
  @property --hB {
    syntax: '<color>';
    inherits: true;
    initial-value: #3fc6f2;
  }
  @property --hC {
    syntax: '<color>';
    inherits: true;
    initial-value: #2ee59d;
  }
  .jx-hero {
    transition:
      --hA 1.6s var(--jx-ease-io),
      --hB 1.6s var(--jx-ease-io),
      --hC 1.6s var(--jx-ease-io);
  }

  .jx-show {
    position: relative;
    user-select: none;
  }

  /* One screen at a time: cinematic cross-fade (fade + slight zoom + blur) */
  .jx-show__stage {
    position: relative;
    display: grid;
    aspect-ratio: 1144 / 740;
    padding: 10px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(6px);
    box-shadow:
      var(--jx-shadow-lg),
      inset 0 0 0 1px rgba(255, 255, 255, 0.9),
      0 0 0 1px color-mix(in srgb, var(--hB) 25%, transparent);
    transform: perspective(1200px) rotateX(calc(var(--ry, 0) * -3deg)) rotateY(calc(var(--rx, 0) * 4deg));
    transition: transform 1s var(--jx-ease);
    touch-action: pan-y;
  }
  .jx-c3 {
    grid-area: 1 / 1;
    position: relative;
    display: block;
    border-radius: 18px;
    overflow: hidden;
    background: var(--jx-night);
    color: #fff;
    text-decoration: none;
    opacity: 0;
    scale: 1.04;
    filter: blur(10px);
    visibility: hidden;
    transition:
      opacity 1.1s var(--jx-ease-io),
      scale 1.4s var(--jx-ease-io),
      filter 1.1s var(--jx-ease-io),
      visibility 0s linear 1.4s;
    -webkit-user-drag: none;
  }
  .jx-c3.is-active {
    opacity: 1;
    scale: 1;
    filter: none;
    visibility: visible;
    z-index: 1;
    transition-delay: 0s;
  }
  .jx-c3__media {
    position: absolute;
    inset: 0;
    display: block;
    container-type: inline-size;
  }
  .jx-c3__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.12;
    transition: scale 7s cubic-bezier(0.25, 0.4, 0.3, 1);
  }
  .jx-c3.is-active .jx-c3__media img {
    scale: 1;
  }
  .jx-c3__badge {
    position: absolute;
    right: 16px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--jx-green);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
  }
  /* The only text on a screen: number + name */
  .jx-c3__label {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px 9px 10px;
    border-radius: 999px;
    background: rgba(11, 26, 54, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.9375rem;
    font-weight: 600;
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.6s var(--jx-ease),
      translate 0.8s var(--jx-ease);
  }
  .jx-c3.is-active .jx-c3__label {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.6s;
  }
  .jx-c3__label b {
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 24px;
    padding-inline: 6px;
    border-radius: 999px;
    background: var(--hA);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }
  .jx-c3__label svg {
    transition: translate var(--jx-fast) var(--jx-ease);
  }
  .jx-c3:hover .jx-c3__label svg {
    translate: 4px 0;
  }

  /* Card visual: terminal */
  .jx-term {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4cqw;
    padding: 9cqw 6cqw 6cqw;
    background:
      radial-gradient(circle at 85% 10%, rgba(26, 143, 224, 0.45), transparent 50%),
      linear-gradient(160deg, #081429, #10264d);
    color: #d9e6f2;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 2.5cqw;
  }
  .jx-term__bar {
    position: absolute;
    top: 4cqw;
    right: 4.5cqw;
    display: flex;
    gap: 1.2cqw;
  }
  .jx-term__bar i {
    width: 1.6cqw;
    height: 1.6cqw;
    border-radius: 50%;
    background: #ff5f57;
  }
  .jx-term__bar i:nth-child(2) {
    background: #febc2e;
  }
  .jx-term__bar i:nth-child(3) {
    background: #28c840;
  }
  .jx-term__ln {
    white-space: nowrap;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
  }
  .jx-term b {
    color: #3fc6f2;
  }
  .jx-term__ln.is-ok,
  .jx-term__ln.is-ok b {
    color: #7be495;
  }
  .jx-c3.is-active .jx-term__ln {
    animation: jx-type 0.5s steps(20, end) forwards;
    animation-delay: calc(0.9s + var(--k) * 0.45s);
  }
  .jx-c3:not(.is-active) .jx-term__ln {
    clip-path: inset(0 0 0 0);
  }
  @keyframes jx-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .jx-term__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    vertical-align: -2px;
    background: #3fc6f2;
    animation: jx-blink 1s steps(2) infinite;
  }
  @keyframes jx-blink {
    50% {
      opacity: 0;
    }
  }

  /* Card visual: network */
  .jx-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 50%, rgba(46, 229, 157, 0.22), transparent 55%),
      linear-gradient(150deg, #0b1a36, #13306a);
  }
  .jx-net__base {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 2.5;
  }
  .jx-net__pulse {
    stroke: #2ee59d;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 16 300;
    stroke-dashoffset: 316;
  }
  .jx-c3.is-active .jx-net__pulse {
    animation: jx-pulse 2.2s linear infinite;
    animation-delay: calc(var(--k) * 0.35s);
  }
  @keyframes jx-pulse {
    to {
      stroke-dashoffset: 0;
    }
  }
  .jx-net__node {
    fill: #10264d;
    stroke: #3fc6f2;
    stroke-width: 3;
  }
  .jx-net__hub {
    fill: #fff;
    filter: drop-shadow(0 0 24px rgba(46, 229, 157, 0.7));
  }

  /* Card visual: products */
  .jx-prods {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5cqw;
    background:
      radial-gradient(circle at 20% 15%, rgba(46, 229, 157, 0.4), transparent 45%),
      var(--jx-blob-royal);
  }
  .jx-prods__card {
    display: grid;
    place-items: center;
    width: 16cqw;
    aspect-ratio: 1;
    border-radius: 4.5cqw;
    background: #fff;
    box-shadow: 0 4cqw 8cqw rgba(5, 20, 60, 0.3);
  }
  .jx-prods__card img {
    width: 66%;
  }
  .jx-c3.is-active .jx-prods__card {
    animation: jx-float 5s ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.6s);
  }


  /* Nav: arrows, counter, progress */
  .jx-show__nav {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding-inline: 4px;
  }
  .jx-show__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #d6dde4;
    background: #fff;
    cursor: pointer;
    transition:
      background-color var(--jx-fast),
      color var(--jx-fast),
      border-color var(--jx-fast);
  }
  .jx-show__btn:hover {
    background: var(--jx-blue);
    border-color: var(--jx-blue);
    color: #fff;
  }
  .jx-show__count {
    font-size: 0.875rem;
    color: var(--jx-grey);
    font-variant-numeric: tabular-nums;
  }
  .jx-show__count b {
    color: var(--jx-ink);
    font-weight: 600;
  }
  .jx-show__bar {
    flex: 1;
    max-width: 220px;
    height: 3px;
    border-radius: 3px;
    background: rgba(30, 61, 126, 0.12);
    overflow: hidden;
  }
  .jx-show__bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--hA), var(--hC));
    transform: scaleX(0);
    transform-origin: left;
  }
  .jx-show.is-auto .jx-show__bar i {
    animation: jx-prog var(--slide-time, 5.5s) linear forwards;
  }
  .jx-show.is-hold .jx-show__bar i {
    animation-play-state: paused;
  }

  @media (max-width: 960px) {
    .jx-show {
      --cw: clamp(200px, 46vw, 300px);
    }
  }
  @media (max-width: 560px) {
    .jx-show {
      --cw: 58vw;
    }
    .jx-show__desc {
      font-size: 0.875rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jx-show__ring {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .jx-c3__label {
      left: 10px;
      bottom: 10px;
      font-size: 0.8125rem;
      padding: 7px 12px 7px 8px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-show]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.jx-show__stage')!;
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('.jx-c3')];
    const cur = root.querySelector('[data-cur]')!;
    const theme = (root.closest('.jx-hero') as HTMLElement) ?? root;
    const pals: [string, string, string][] = JSON.parse(root.dataset.palettes || '[]');
    const n = cards.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TIME = 5500;
    let idx = 0;
    let timer = 0;
    let inView = true;
    const pad = (x: number) => String(x).padStart(2, '0');

    const paint = () => {
      cards.forEach((c, k) => {
        const on = k === idx;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-hidden', on ? 'false' : 'true');
        c.tabIndex = on ? 0 : -1;
      });
      const [a, b, cc] = pals[idx] ?? [];
      if (a) {
        theme.style.setProperty('--hA', a);
        theme.style.setProperty('--hB', b);
        theme.style.setProperty('--hC', cc);
      }
      cur.textContent = pad(idx + 1);
    };
    const go = (k: number) => {
      idx = ((k % n) + n) % n;
      // restart the incoming screen's own animations (zoom, typing, pulses) from the start
      const el = cards[idx];
      el.classList.remove('is-active');
      void el.offsetWidth;
      paint();
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      root.classList.remove('is-auto');
      if (reduce) return;
      void root.offsetWidth;
      root.style.setProperty('--slide-time', `${TIME}ms`);
      root.classList.add('is-auto');
      timer = window.setTimeout(tick, TIME);
    };
    const tick = () => {
      if (root.classList.contains('is-hold') || !inView || document.hidden) {
        timer = window.setTimeout(tick, 500);
        return;
      }
      go(idx + 1);
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(idx - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(idx + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(idx + 1);
      if (e.key === 'ArrowLeft') go(idx - 1);
    });
    root.addEventListener('pointerenter', () => root.classList.add('is-hold'));
    root.addEventListener('pointerleave', () => root.classList.remove('is-hold'));
    root.addEventListener('focusin', () => root.classList.add('is-hold'));
    root.addEventListener('focusout', () => root.classList.remove('is-hold'));
    // swipe; a swipe must not also follow the screen's link
    let x0: number | null = null;
    let swiped = false;
    stage.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      swiped = false;
    });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) {
        swiped = true;
        go(idx + (dx < 0 ? 1 : -1));
      }
    });
    stage.addEventListener('click', (e) => {
      if (swiped) {
        e.preventDefault();
        swiped = false;
      }
    });

    new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.3 }).observe(root);
    paint();
    schedule();
  });
</script>
