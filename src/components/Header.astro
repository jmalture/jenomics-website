---
/**
 * Site header: logo, mega menu "Leistungen" (services, products, company), page links,
 * language switch, Fernzugriff (TeamViewer) and the contact CTA. Below 1080px a full-screen drawer.
 * Behaviour (glass on scroll, hide on scroll down, menu/drawer toggles) is in src/scripts/site.ts.
 */
import Icon from './ui/Icon.astro';
import { LANGS, dict, pick, fill, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import offer from '../i18n/offer.json';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const t = dict(chrome, lang);
const o = pick(offer, lang);
const home = lang === 'de' ? '/' : '/en/';
const links = [
  [t.h_career, t.h_career_href],
  [t.h_blog, t.h_blog_href],
  [t.h_pricing, t.h_pricing_href],
  [t.h_contact, t.h_contact_href],
];
const remote = 'https://get.teamviewer.com/tnedds2';
---

<header class="jx-hd" data-header>
  <div class="jx-hd__bar jx-wrap">
    <a class="jx-hd__logo" href={home} aria-label={t.h_home_aria}>
      <img src="/media/jenomics-logo.webp" alt="Jenomics" width="180" height="38" />
    </a>

    <nav class="jx-nav" aria-label="Hauptnavigation">
      <ul class="jx-nav__list">
        <li class="jx-nav__item jx-nav__item--mega" data-mega>
          <a class="jx-nav__link" href={t.h_services_href}>{t.h_services_menu}</a>
          <button class="jx-nav__caret" aria-expanded="false" aria-controls="jx-mega" aria-label={t.h_services_open}>
            <Icon name="chevron" size={16} />
          </button>
          <div class="jx-mega" id="jx-mega">
            <div class="jx-mega__inner">
              <div class="jx-mega__col jx-mega__col--services">
                <p class="jx-mega__label">{t.h_col_services}</p>
                <ul class="jx-mega__grid">
                  {
                    o.services.map((s, i) => (
                      <li style={`--i:${i}`}>
                        <a class="jx-mega__card" href={s.href}>
                          <span class="jx-mega__ico">
                            <Icon name={s.key as any} size={20} />
                          </span>
                          <span>
                            <strong>{s.name}</strong>
                            <small>{s.desc}</small>
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="jx-mega__col">
                <p class="jx-mega__label jx-mega__label--green">{t.h_col_products}</p>
                <ul class="jx-mega__list">
                  {
                    o.products.map((p, i) => (
                      <li style={`--i:${i + 6}`}>
                        <a class="jx-mega__card" href={p.href}>
                          <img src={p.icon} alt="" width="40" height="40" loading="lazy" />
                          <span>
                            <strong>{p.name}</strong>
                            <small>{p.desc}</small>
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="jx-mega__col jx-mega__col--company">
                <p class="jx-mega__label">{t.h_col_company}</p>
                <a class="jx-mega__photo" href={t.h_about_href} style="--i:9">
                  <img src="/media/about-team.webp" alt="" width="600" height="426" loading="lazy" />
                  <span><strong>{t.h_about}</strong><small>{fill(t.h_about_desc)}</small></span>
                </a>
                <a class="jx-mega__photo" href={t.h_team_href} style="--i:10">
                  <img src="/media/about-handshake.webp" alt="" width="600" height="400" loading="lazy" />
                  <span><strong>{t.h_team}</strong><small>{t.h_team_desc}</small></span>
                </a>
              </div>
            </div>
          </div>
        </li>
        <li class="jx-nav__item"><a class="jx-nav__link" href={t.h_about_href}>{t.h_about}</a></li>
        {
          links.map(([label, href]) => (
            <li class="jx-nav__item">
              <a class="jx-nav__link" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="jx-hd__tools">
      <div class="jx-lang" role="group" aria-label={t.h_lang_label}>
        {
          LANGS.map((l) => (
            <a
              href={alternates[l.code] ?? (l.code === 'de' ? '/' : '/en/')}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.code === lang ? 'true' : undefined}
              title={l.name}
            >
              {l.short}
            </a>
          ))
        }
      </div>
      <a class="jx-remote" href={remote} target="_blank" rel="noopener" title={t.h_remote_title}>
        <Icon name="remote" size={18} /><span>{t.h_remote}</span>
      </a>
      <a class="jx-btn jx-btn--sm jx-hd__cta" href={t.h_contact_href}>{t.h_cta}<Icon name="arrow" /></a>
      <button class="jx-burger" aria-expanded="false" aria-controls="jx-drawer" aria-label={t.h_burger} data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="jx-drawer" id="jx-drawer" data-drawer>
    <div class="jx-drawer__inner jx-wrap">
      <details class="jx-drawer__group" open>
        <summary>{t.h_col_services}<Icon name="chevron" size={18} /></summary>
        <ul>
          {
            o.services.map((s) => (
              <li>
                <a href={s.href}>
                  <Icon name={s.key as any} size={18} />
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <details class="jx-drawer__group">
        <summary>{t.h_col_products}<Icon name="chevron" size={18} /></summary>
        <ul>
          {
            o.products.map((p) => (
              <li>
                <a href={p.href}>
                  <img src={p.icon} alt="" width="22" height="22" loading="lazy" />
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <ul class="jx-drawer__links">
        <li><a href={t.h_about_href}>{t.h_about}</a></li>
        <li><a href={t.h_team_href}>{t.h_team}</a></li>
        {
          links.map(([label, href]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
      <div class="jx-drawer__foot">
        <a class="jx-btn" href={t.h_contact_href}>{t.h_cta}<Icon name="arrow" /></a>
        <a class="jx-remote jx-remote--full" href={remote} target="_blank" rel="noopener"
          ><Icon name="remote" size={18} /><span>{t.h_remote}</span></a
        >
      </div>
    </div>
  </div>
</header>

<style is:global>
  .jx-hd {
    position: sticky;
    top: 0;
    z-index: 100;
    view-transition-name: jx-header;
    transition: translate var(--jx-med) var(--jx-ease);
  }
  .jx-hd::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid transparent;
    opacity: 0;
    transition:
      opacity var(--jx-med) var(--jx-ease),
      border-color var(--jx-med) var(--jx-ease);
  }
  .jx-hd.is-scrolled::before {
    opacity: 1;
    border-color: rgba(30, 61, 126, 0.08);
  }
  .jx-hd.is-hidden:not(.is-open) {
    translate: 0 -100%;
  }
  .jx-hd__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--jx-header-h);
  }
  .jx-hd__logo {
    flex: none;
    display: block;
    transition: opacity var(--jx-fast);
  }
  .jx-hd__logo img {
    width: 168px;
    height: auto;
  }
  .jx-hd__logo:hover {
    opacity: 0.8;
  }

  /* Desktop nav */
  .jx-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .jx-nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jx-nav__item {
    position: static;
    display: flex;
    align-items: center;
  }
  .jx-nav__link {
    position: relative;
    padding: 10px 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--jx-ink);
    text-decoration: none;
    border-radius: 8px;
    transition: color var(--jx-fast);
  }
  .jx-nav__link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--jx-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--jx-med) var(--jx-ease);
  }
  .jx-nav__link:hover {
    color: var(--jx-blue);
  }
  .jx-nav__link:hover::after,
  .jx-nav__item--mega.is-open .jx-nav__link::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .jx-nav__item--mega .jx-nav__link {
    padding-right: 4px;
  }
  .jx-nav__item--mega .jx-nav__link::after {
    right: 4px;
  }
  .jx-nav__caret {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    color: var(--jx-grey);
    transition:
      rotate var(--jx-med) var(--jx-ease),
      color var(--jx-fast);
  }
  .jx-nav__item--mega.is-open .jx-nav__caret {
    rotate: 180deg;
    color: var(--jx-blue);
  }

  /* Mega panel */
  .jx-mega {
    position: absolute;
    left: var(--jx-gutter);
    right: var(--jx-gutter);
    top: calc(100% - 6px);
    padding-top: 6px;
    visibility: hidden;
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity var(--jx-fast) var(--jx-ease),
      translate var(--jx-med) var(--jx-ease),
      visibility 0s linear var(--jx-med);
  }
  .jx-nav__item--mega.is-open .jx-mega {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition-delay: 0s;
  }
  .jx-mega__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 28px;
    padding: 28px;
    border-radius: var(--jx-r-xl);
    background: #fff;
    border: 1px solid rgba(30, 61, 126, 0.08);
    box-shadow: var(--jx-shadow-lg);
  }
  .jx-mega__label {
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--jx-blue-k);
  }
  .jx-mega__label--green {
    color: #3a9e3b;
  }
  .jx-mega__grid,
  .jx-mega__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .jx-mega__grid {
    grid-template-columns: 1fr 1fr;
  }
  .jx-mega li,
  .jx-mega__photo {
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity var(--jx-med) var(--jx-ease),
      translate var(--jx-med) var(--jx-ease);
  }
  .jx-nav__item--mega.is-open .jx-mega li,
  .jx-nav__item--mega.is-open .jx-mega__photo {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i) * 25ms + 60ms);
  }
  .jx-mega__card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color var(--jx-fast);
  }
  .jx-mega__card:hover {
    background: #f3f7fa;
  }
  .jx-mega__card strong,
  .jx-mega__photo strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .jx-mega__card small,
  .jx-mega__photo small {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--jx-grey);
  }
  .jx-mega__ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--jx-blue);
    background: linear-gradient(140deg, #e3f2fb, #e9f8ee);
    transition:
      background var(--jx-fast),
      color var(--jx-fast);
  }
  .jx-mega__card:hover .jx-mega__ico {
    color: #fff;
    background: var(--jx-blue);
  }
  .jx-mega__card img {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .jx-mega__col--company {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .jx-mega__photo {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    align-items: center;
    padding: 8px;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color var(--jx-fast);
  }
  .jx-mega__photo:hover {
    background: #f3f7fa;
  }
  .jx-mega__photo img {
    width: 88px;
    height: 66px;
    object-fit: cover;
    border-radius: 10px;
  }

  /* Tools */
  .jx-hd__tools {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .jx-lang {
    display: flex;
    padding: 3px;
    border-radius: 10px;
    background: rgba(235, 239, 242, 0.8);
  }
  .jx-lang a {
    padding: 5px 9px;
    border-radius: 7px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--jx-grey);
    text-decoration: none;
    transition:
      background-color var(--jx-fast),
      color var(--jx-fast);
  }
  .jx-lang a[aria-current] {
    background: #fff;
    color: var(--jx-ink);
    box-shadow: var(--jx-shadow-sm);
  }
  .jx-lang a:not([aria-current]):hover {
    color: var(--jx-blue);
  }
  .jx-remote {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 8px 14px;
    border-radius: var(--jx-r);
    border: 1px solid rgba(243, 113, 35, 0.35);
    color: #c95412;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--jx-fast),
      color var(--jx-fast),
      border-color var(--jx-fast);
  }
  .jx-remote:hover {
    background: var(--jx-orange);
    border-color: var(--jx-orange);
    color: #fff;
  }
  .jx-burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: var(--jx-surface);
    cursor: pointer;
    position: relative;
  }
  .jx-burger span {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--jx-ink);
    transition:
      translate var(--jx-med) var(--jx-ease),
      rotate var(--jx-med) var(--jx-ease),
      opacity var(--jx-fast);
  }
  .jx-burger span:nth-child(1) {
    top: 15px;
  }
  .jx-burger span:nth-child(2) {
    top: 21px;
  }
  .jx-burger span:nth-child(3) {
    top: 27px;
    width: 12px;
  }
  .jx-hd.is-open .jx-burger span:nth-child(1) {
    translate: 0 6px;
    rotate: 45deg;
  }
  .jx-hd.is-open .jx-burger span:nth-child(2) {
    opacity: 0;
  }
  .jx-hd.is-open .jx-burger span:nth-child(3) {
    width: 18px;
    translate: 0 -6px;
    rotate: -45deg;
  }

  /* Drawer (mobile / tablet) */
  .jx-drawer {
    position: fixed;
    inset: var(--jx-header-h) 0 0 0;
    background: #fff;
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path var(--jx-med) var(--jx-ease-io),
      visibility 0s linear var(--jx-med);
  }
  .jx-hd.is-open .jx-drawer {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition-delay: 0s;
  }
  .jx-drawer__inner {
    display: grid;
    gap: 8px;
    padding-block: 16px 40px;
  }
  .jx-drawer__group {
    border-bottom: 1px solid var(--jx-line);
  }
  .jx-drawer__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-size: 1.25rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .jx-drawer__group summary::-webkit-details-marker {
    display: none;
  }
  .jx-drawer__group[open] summary svg {
    rotate: 180deg;
  }
  .jx-drawer__group summary svg {
    transition: rotate var(--jx-med) var(--jx-ease);
  }
  .jx-drawer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jx-drawer__group ul {
    padding-bottom: 12px;
  }
  .jx-drawer__group a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 4px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--jx-ink);
  }
  .jx-drawer__group a svg {
    color: var(--jx-blue);
  }
  .jx-drawer__links a {
    display: block;
    padding: 14px 0;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--jx-line);
  }
  .jx-drawer__foot {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  .jx-remote--full {
    justify-content: center;
    min-height: 52px;
  }

  @media (max-width: 1180px) {
    .jx-hd__bar {
      gap: 16px;
    }
    .jx-nav__link {
      padding-inline: 9px;
    }
    .jx-remote span {
      display: none;
    }
  }
  @media (max-width: 1080px) {
    .jx-nav,
    .jx-hd__cta,
    .jx-hd__tools > .jx-remote {
      display: none;
    }
    .jx-burger {
      display: block;
    }
    .jx-hd.is-open::before {
      opacity: 1;
      background: #fff;
    }
  }
  @media (max-width: 420px) {
    .jx-hd__logo img {
      width: 138px;
    }
  }
</style>
