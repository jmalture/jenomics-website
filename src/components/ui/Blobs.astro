---
/**
 * A field of live blobs (see .jx-blob in site.css). Put it inside a position:relative parent.
 * Each blob: x/y position (any CSS length), size, gradient (green | blue | royal | css), duration,
 * drift (dx/dy), depth (pointer parallax in px), opacity, soft (blurred glow).
 */
interface BlobSpec {
  x: string;
  y: string;
  size: string;
  g?: 'green' | 'blue' | 'royal' | string;
  d?: number;
  delay?: number;
  dx?: string;
  dy?: string;
  depth?: number;
  o?: number;
  soft?: boolean;
}
interface Props {
  blobs: BlobSpec[];
  class?: string;
}
const { blobs, class: cls } = Astro.props;
const grad = (g?: string) =>
  !g || g === 'green'
    ? 'var(--jx-blob-green)'
    : g === 'blue'
      ? 'var(--jx-blob-blue)'
      : g === 'royal'
        ? 'var(--jx-blob-royal)'
        : g;
---

<div class:list={['jx-blobs', cls]} data-blobs aria-hidden="true">
  {
    blobs.map((b) => (
      <div
        class:list={['jx-blob', { 'jx-blob--soft': b.soft }]}
        style={`--x:${b.x};--y:${b.y};--size:${b.size};--g:${grad(b.g)};--d:${b.d ?? 18}s;--delay:${-(b.delay ?? 0)}s;--dx:${b.dx ?? '6%'};--dy:${b.dy ?? '-5%'};--depth:${b.depth ?? 20}px;--o:${b.o ?? 1}`}
      >
        <span />
      </div>
    ))
  }
</div>
