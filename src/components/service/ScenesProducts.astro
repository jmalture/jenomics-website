---
/**
 * Scenes for the product pages: IKONA (shop, helpdesk, editor, backoffice, produce, api, portal),
 * SDX (sdx, sdxfiles, sdxrights, sdxaudit, sdxnotify, sdxshare, sdxbrand) and Großmarkt GM8
 * (gm8, gmmail, gmstock, gmbatch, gmin, gmout, gmarchive, gmdeposit, gmmaster).
 * Rendered inside Scene.astro's .jx-scene frame; shared helpers live there. Generic sample data only.
 */
import type { Lang } from '../../i18n';

interface Props {
  name: string;
  lang: Lang;
}
const { name, lang } = Astro.props;

const T = {
