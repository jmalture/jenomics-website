    rows: [
      ['RE-2041', 'Fruit Huber', '€1,240.50'],
      ['RE-2042', 'Veg Lang', '€386.20'],
      ['RE-2043', 'Market Café', '€92.80'],
      ['RE-2044', 'Hotel Isar', '€2,015.00'],
    ],
