const check =
  '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
const svg = (d: string, s = 16) =>
  `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  file: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>'),
  upload: svg('<path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 21h14"/>', 22),
  link: svg('<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>'),
  mail: svg('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>'),
  print: svg('<path d="M6 9V2h12v7"/><rect x="2" y="9" width="20" height="9" rx="2"/><path d="M6 14h12v8H6z"/>', 18),
  truck: svg('<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>', 20),
  folder: svg('<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>', 22),
  cart: svg('<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L22 8H6"/>'),
  shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'),
};
// Product mock-ups for the shop / editor (simple shapes, coloured by the page palette)
const prodShapes = ['mug', 'poster', 'shirt', 'cal'];
// QR-ish pattern: deterministic 9 × 9 grid
const qr = Array.from({ length: 81 }, (_, i) => ((i * 7 + (i % 9) * 3) % 5 < 2 ? 1 : 0));
---

{
  name === 'shop' && (
    <div class="sc-win sc-shop">
      <div class="sc-spa__top">
        <span class="sc-dots">
          <i />
          <i />
          <i />
        </span>
        <span class="sc-spa__addr">www.foto-portal.de</span>
        <span class="sc-shop__cart">
          <i set:html={I.cart} />
          <b>
            <span class="sc-stack">
              <em class="sc-shop__n1">2</em>
              <em class="sc-shop__n2">3</em>
            </span>
          </b>
        </span>
      </div>
      <div class="sc-shop__body">
        <b class="sc-shop__h">{T.shop}</b>
        <div class="sc-shop__grid">
          {T.products.map((p, i) => (
            <span class="sc-card sc-shop__item" style={`--k:${i}`}>
              <span class={`sc-prod sc-prod--${prodShapes[i]}`}>
                <i />
              </span>
              <small>{p}</small>
            </span>
          ))}
        </div>
      </div>
      <span class="sc-chip sc-late sc-shop__chip" style="--dl:.8s">
        <i set:html={check} />
        {T.in_prod}
      </span>
    </div>
  )
}

{
  name === 'helpdesk' && (
    <div class="sc-win sc-desk">
      <div class="sc-bar">
        <span class="sc-live" />
        {T.helpdesk}
        <em>{T.realtime}</em>
      </div>
      <ul>
        {T.tickets.map(([n, s, st], i) => (
          <li style={`--k:${i}`}>
            <code class="sc-mono">{n}</code>
            <span>{s}</span>
            <em class:list={[`is-${i}`]}>{st}</em>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  name === 'editor' && (
    <div class="sc-win sc-ed">
      <div class="sc-bar">
        {T.editor}
        <em>{T.preview}</em>
      </div>
      <div class="sc-ed__body">
        <div class="sc-ed__canvas">
          <span class="sc-ed__mug">
            <span class="sc-ed__photo" />
            <span class="sc-ed__txt">
              <span>{T.mug_text}</span>
            </span>
          </span>
        </div>
        <aside class="sc-ed__side">
          <small>{T.templates}</small>
          {[0, 1, 2].map((k) => (
            <i style={`--o:${k}`} class:list={[{ 'is-on': k === 1 }]} />
          ))}
        </aside>
      </div>
    </div>
  )
}

{
  name === 'backoffice' && (
    <div class="sc-win sc-bo">
      <div class="sc-bar">{T.dashboard}</div>
      <div class="sc-bo__kpis">
        {T.kpis.map(([l, v], i) => (
          <span class="sc-s" style={`--k:${i};--g:.35s`}>
            <small>{l}</small>
            <b>{v}</b>
          </span>
        ))}
      </div>
      <div class="sc-bo__chart">
        {[30, 44, 38, 56, 50, 68, 62, 80].map((h, i) => (
          <i style={`--h:${h}%;--k:${i}`} />
        ))}
      </div>
      <div class="sc-bo__foot">
        <span class="sc-bo__tag">{T.voucher}</span>
        <span class="sc-bo__tag sc-bo__tag--warn">{T.dunning}</span>
      </div>
    </div>
  )
}

{
  name === 'produce' && (
    <div class="sc-pipe">
      <ol>
        {T.steps.map((s, i) => (
          <li style={`--k:${i}`}>
            <span class="sc-ci__dot">
              <i set:html={check} />
            </span>
            <small>{s}</small>
          </li>
        ))}
      </ol>
      <div class="sc-pipe__road">
        <span class="sc-pipe__box" set:html={I.truck} />
      </div>
      <span class="sc-chip sc-late sc-pipe__chip" style="--dl:-1s">
        <i set:html={check} />
        {T.proof_ok}
      </span>
    </div>
  )
}

{
  name === 'api' && (
    <div class="sc-api">
      <div class="sc-term sc-api__req">
        <div class="sc-bar">
          <span class="sc-dots">
            <i />
            <i />
            <i />
          </span>
          POST /api/orders
        </div>
        <div class="sc-mono sc-pre">
          {[
            '{',
            '  <b>"product"</b>: <em>"mug-white"</em>,',
            '  <b>"template"</b>: <em>"birthday"</em>,',
            '  <b>"qty"</b>: <em>2</em>',
            '}',
          ].map((l, i) => (
            <span class="sc-s" style={`--k:${i};--g:.3s`} set:html={l} />
          ))}
        </div>
      </div>
      <div class="sc-card sc-api__res sc-late" style="--dl:.2s">
        <span class="sc-api__code">201</span>
        <span>
          <b>Created</b>
          <small class="sc-mono">order_id: 58213</small>
        </span>
      </div>
      <span class="sc-chip sc-api__hook">
        <span class="sc-live" />
        webhook · order.created
      </span>
    </div>
  )
}

{
  name === 'portal' && (
    <div class="sc-win sc-brand sc-portal">
      <div class="sc-brand__top">
        <span class="sc-brand__logo" />
        <b>{T.portal}</b>
        <span class="sc-brand__menu">
          <i />
          <i />
          <i />
        </span>
      </div>
      <div class="sc-portal__body">
        <div class="sc-portal__hero">
          <i class="sc-sk" style="width:60%;height:8px" />
          <i class="sc-sk" style="width:40%" />
          <em />
        </div>
        <div class="sc-portal__pay">
          {T.pay.map((p, i) => (
            <span class="sc-s" style={`--k:${i};--g:.4s`}>
              {p}
            </span>
          ))}
        </div>
        <span class="sc-portal__trust">
          <i set:html={I.shield} />
          {T.trusted}
        </span>
      </div>
      <aside class="sc-brand__side sc-portal__side">
        <span class="sc-brand__sw">
          <i />
          <i />
          <i />
          <b />
        </span>
      </aside>
    </div>
  )
}

{
  name === 'sdx' && (
    <div class="sc-sdx">
      <div class="sc-win sc-sdx__drop">
        <div class="sc-bar">
          <span class="sc-dc__sdx">SDX</span>
          {T.upload}
        </div>
        <div class="sc-sdx__zone">
          <i set:html={I.upload} />
          <span>{T.drop}</span>
          <span class="sc-card sc-sdx__file">
            <i set:html={I.file} />
            {T.file}
            <span class="sc-fill" style="--k:1;--g:.8s;--d:9s" />
          </span>
        </div>
      </div>
      <div class="sc-card sc-sdx__link">
        <i set:html={I.link} />
        <span>
          <b>{T.link}</b>
          <small class="sc-mono">sdx.app/s/7Kq2…</small>
        </span>
      </div>
      <span class="sc-chip sc-sdx__note">
        <i set:html={check} />
        {T.notified}
      </span>
    </div>
  )
}

{
  name === 'sdxfiles' && (
    <div class="sc-files">
      {['.xlsx', '.docx', '.pdf', '.html', '.json', '.zip'].map((f, i) => (
        <span class="sc-card sc-files__f" style={`--k:${i}`}>
          <i set:html={I.file} />
          <b>{f}</b>
          <span class="sc-fill" style={`--k:${i};--g:.45s`} />
        </span>
      ))}
    </div>
  )
}

{
  name === 'sdxrights' && (
    <div class="sc-win sc-rights">
      <div class="sc-bar">{T.rights}</div>
      <table>
        <thead>
          <tr>
            <th />
            {T.perms.map((p) => (
              <th>{p}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {T.users.map((u, r) => (
            <tr>
              <td>
                <span class="sc-avatar" />
                {u}
              </td>
              {[0, 1, 2].map((c) => (
                <td>
                  <b class:list={['sc-ccfg__tg', { 'is-off': (r === 2 && c > 0) || (r === 1 && c === 2) }]} style={`--k:${r * 3 + c}`} />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  name === 'sdxaudit' && (
    <div class="sc-win sc-audit">
      <div class="sc-bar">{T.audit}</div>
      <ol>
        {T.events.map(([e, t], i) => (
          <li class="sc-s" style={`--k:${i};--g:.6s`}>
            <i />
            <span>{e}</span>
            <time class="sc-mono">{t}</time>
          </li>
        ))}
      </ol>
    </div>
  )
}

{
  name === 'sdxnotify' && (
    <div class="sc-notify">
      <span class="sc-notify__env" set:html={svg('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>', 28)} />
      <div class="sc-win sc-notify__mail">
        <div class="sc-bar">
          {T.report}
          <em>SDX</em>
        </div>
        <ul>
          {T.changes.map((c, i) => (
            <li class="sc-s" style={`--k:${i + 1};--g:.5s`}>
              <i set:html={check} />
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

{
  name === 'sdxshare' && (
    <div class="sc-win sc-share">
      <div class="sc-bar">{T.share}</div>
      <div class="sc-share__tabs">
        <b class="sc-share__ind" />
        {T.tabs.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <div class="sc-share__view sc-stack">
        <div class="sc-c3" style="--k:0">
          <span class="sc-share__field">kunde@example.de</span>
        </div>
        <div class="sc-c3" style="--k:1">
          <span class="sc-share__field sc-mono">sdx.app/s/7Kq2xP</span>
        </div>
        <div class="sc-c3 sc-share__qr" style="--k:2">
          {qr.map((on) => (
            <i class:list={[{ on }]} />
          ))}
        </div>
      </div>
    </div>
  )
}

{
  name === 'sdxbrand' && (
    <div class="sc-win sc-brand">
      <div class="sc-brand__top">
        <span class="sc-brand__logo" />
        <span class="sc-stack">
          <b class="sc-c3" style="--k:0">
            SDX
          </b>
          <b class="sc-c3" style="--k:1">
            {T.brand}
          </b>
          <b class="sc-c3" style="--k:2">
            {T.brand}
          </b>
        </span>
        <span class="sc-brand__menu">
          <i />
          <i />
          <i />
        </span>
      </div>
      <div class="sc-brand__body">
        <div class="sc-brand__tiles">
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <span class="sc-card">
              <b style={`--o:${i % 3}`} />
              <i class="sc-sk" style="width:70%" />
            </span>
          ))}
        </div>
        <aside class="sc-brand__side">
          <span class="sc-brand__sw">
            <i />
            <i />
            <i />
            <b />
          </span>
          <i class="sc-sk" style="width:80%" />
          <i class="sc-sk" style="width:60%" />
        </aside>
      </div>
    </div>
  )
}

{
  name === 'gm8' && (
    <div class="sc-win sc-gm">
      <div class="sc-bar">
        <img src="/media/product-grossmarkt.webp" alt="" width="18" height="18" />
        {T.gm8}
        <em class="sc-gm__btn">{T.batch}</em>
      </div>
      <table>
        <tbody>
          {T.rows.map(([n, c, s], i) => (
            <tr class="sc-s" style={`--k:${i};--g:.4s`}>
              <td class="sc-mono">{n}</td>
              <td>{c}</td>
              <td>{s}</td>
              <td>
                <b class="sc-gm__st" style={`--k:${i}`} set:html={check} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  name === 'gmmail' && (
    <div class="sc-gmmail">
      <span class="sc-card sc-gmmail__doc">
        <i set:html={I.file} />
        RE-2041 … 2052
      </span>
      {[0, 1, 2].map((k) => (
        <span class="sc-gmmail__env" style={`--k:${k}`} set:html={I.mail} />
      ))}
      <span class="sc-chip sc-late sc-gmmail__chip" style="--dl:.4s">
        <i set:html={check} />
        12 {T.sent}
      </span>
    </div>
  )
}

{
  name === 'gmstock' && (
    <div class="sc-win sc-stock">
      <div class="sc-bar">{T.stock}</div>
      <ul>
        {T.goods.map((g, i) => (
          <li style={`--k:${i}`}>
            <span>{g}</span>
            <span class="sc-stock__bar">
              <i />
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  name === 'gmbatch' && (
    <div class="sc-batch">
      <div class="sc-batch__stack">
        {[0, 1, 2, 3, 4].map((k) => (
          <span style={`--k:${k}`}>
            <i class="sc-sk" style="width:50%" />
            <i class="sc-sk" style="width:80%" />
            <i class="sc-sk" style="width:65%" />
          </span>
        ))}
      </div>
      <span class="sc-batch__printer" set:html={I.print} />
      <span class="sc-chip sc-late sc-batch__chip" style="--dl:.6s">
        <i set:html={check} />
        {T.printed}: 24
      </span>
    </div>
  )
}

{
  name === 'gmin' && (
    <div class="sc-gmin">
      <div class="sc-card sc-gmin__del">
        <i set:html={I.truck} />
        <span>
          <b>{T.delivery} #318</b>
          <small>{T.goods[0]} · {T.goods[1]}</small>
        </span>
      </div>
      <span class="sc-gmin__arrow" />
