      ['Vouchers', '96'],
    ],
    voucher: 'Voucher SUMMER',
    dunning: 'Dunning · 2 open',
    steps: ['Order', 'Proof', 'Print', 'Shipping'],
    proof_ok: 'Print data checked',
    shipped: 'On its way',
    portal: 'Portal design',
    pay: ['PayPal', 'Invoice', 'Klarna'],
    trusted: 'Trusted Shops',
    upload: 'Upload',
    drop: 'Drop files here',
