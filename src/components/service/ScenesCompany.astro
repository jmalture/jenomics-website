      ].map(([k, l], i) => (
        <span class={`sc-card sc-ch__node sc-ch__node--${i}`} style={`--k:${i}`}>
          <i set:html={ico[k as keyof typeof ico]} />
          {l}
        </span>
      ))}
      <svg class="sc-ch__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M50 50 L22 26" />
        <path d="M50 50 L80 30" />
        <path d="M50 50 L52 82" />
      </svg>
      <span class="sc-chip sc-ch__hours">{T.hours}</span>
      <span class="sc-chip sc-late sc-ch__hello" style="--dl:.6s">
        <i set:html={check} />
        {T.hello}
      </span>
    </div>
  )
}

{
