  /* ---------- minute: 37 minutes are 37 minutes ---------- */
  @property --sc-p {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  .sc-minute {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .sc-minute__ring {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: conic-gradient(var(--hA) calc(var(--sc-p) * 1%), #e6edf3 0);
    animation: sc-ring37 8s var(--jx-ease) infinite;
  }
  @keyframes sc-ring37 {
    0%,
    6% {
      --sc-p: 0;
    }
    46%,
    88% {
