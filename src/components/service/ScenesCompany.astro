---
/**
 * Scenes for the company pages: Über uns (story, values, commit), Team (crew, globe), Karriere (apply),
 * Pricing (meter, invoice, tariff, minute, clock24, skills, ondemand), Kontakt (channels, map).
 * Rendered inside Scene.astro's .jx-scene frame; shared helpers (.sc-s, .sc-c3, .sc-fill …) live there.
 */
import { YEARS, FOUNDED, type Lang } from '../../i18n';

interface Props {
  name: string;
  lang: Lang;
}
const { name, lang } = Astro.props;
const now = FOUNDED + YEARS;

const T = {
  de: {
    founded: 'Gründung',
    founded_sub: '2 Entwickler',
    today: 'Heute',
    today_sub: 'Team aus fast allen IT-Fachbereichen',
    simple: 'IT muss nicht kompliziert sein!',
    points: ['Langfristige Lösungen', 'Individuelle Unterstützung', 'Nachhaltige Konzepte'],
    commit: ['Gemeinnützig', 'Nachhaltig', 'LGBTQIA+ friendly', 'Inklusive Sprache', 'Hund im Büro', 'Flexible Zeiten'],
    crew: ['Wissen teilen', 'Gemeinsam Neues erreichen', 'Spaß dabei'],
    office: 'Office München',
    remote: 'Remote',
    jobs: [
      ['Administrator Windows', 'IT Administration'],
      ['Administrator Linux', 'Linux & Unix'],
      ['Full-Stack Developer Java', 'Softwareentwicklung'],
    ],
    apply: 'Bewerben',
    cv: 'Bewerbung.pdf',
    sent: 'Bewerbung eingegangen',
    session: 'Einsatz läuft',
    task: 'Server-Update',
    tariff: 'Tarif',
    tariff_v: 'Administration',
    daytime: 'Tageszeit',
    daytime_v: 'regulär',
    billed: 'Abgerechnet: 37 Min.',
    invoice: 'Abrechnung',
    lines: [
      ['Helpdesk: Drucker verbunden', '12 Min.'],
      ['Server-Update srv-01', '37 Min.'],
      ['Benutzer angelegt', '8 Min.'],
      ['Backup geprüft', '15 Min.'],
    ],
    total: 'Summe',
    total_v: '72 Min.',
    task_l: 'Leistung',
    who: 'Wer?',
    same: 'Gleicher Tarif',
    minutes: 'Minuten',
    not_rounded: 'nicht aufgerundet',
    service_on: 'Service aktiv',
    day: 'Tag',
    night: 'Nacht',
    one_team: 'Ein Team',
    areas: ['Windows', 'Linux', 'Netzwerk', 'Cloud', 'Security', 'Web', 'Entwicklung', 'Hosting'],
    base: 'Grundgebühr',
    usage: 'Nur bei Bedarf',
    weeks: ['KW 1', 'KW 2', 'KW 3', 'KW 4', 'KW 5', 'KW 6'],
    phone: 'Anruf',
    mail: 'E-Mail',
    visit: 'Vor Ort',
    hours: 'Mo – Fr 9 bis 17 Uhr',
    hello: 'Wir freuen uns auf dich!',
    here: 'Jenomics',
  },
  en: {
    founded: 'Founded',
    founded_sub: '2 developers',
    today: 'Today',
    today_sub: 'Team from almost every field of IT',
    simple: 'IT does not have to be complicated!',
    points: ['Long-term solutions', 'Individual support', 'Sustainable concepts'],
    commit: ['Non-profit', 'Sustainable', 'LGBTQIA+ friendly', 'Inclusive language', 'Dogs in the office', 'Flexible hours'],
    crew: ['Share knowledge', 'Achieve new things together', 'Have fun'],
    office: 'Office Munich',
    remote: 'Remote',
    jobs: [
      ['Administrator Windows', 'IT administration'],
      ['Administrator Linux', 'Linux & Unix'],
      ['Full-stack developer Java', 'Software development'],
    ],
    apply: 'Apply',
    cv: 'Application.pdf',
    sent: 'Application received',
    session: 'Job in progress',
    task: 'Server update',
    tariff: 'Tariff',
    tariff_v: 'Administration',
    daytime: 'Time of day',
    daytime_v: 'regular',
    billed: 'Billed: 37 min',
    invoice: 'Invoice',
    lines: [
      ['Helpdesk: printer connected', '12 min'],
      ['Server update srv-01', '37 min'],
      ['User created', '8 min'],
      ['Backup checked', '15 min'],
    ],
    total: 'Total',
    total_v: '72 min',
    task_l: 'Service',
    who: 'Who?',
    same: 'Same tariff',
    minutes: 'minutes',
    not_rounded: 'not rounded up',
    service_on: 'Service active',
    day: 'Day',
    night: 'Night',
    one_team: 'One team',
    areas: ['Windows', 'Linux', 'Network', 'Cloud', 'Security', 'Web', 'Development', 'Hosting'],
    base: 'Base fee',
    usage: 'Only when needed',
    weeks: ['Wk 1', 'Wk 2', 'Wk 3', 'Wk 4', 'Wk 5', 'Wk 6'],
    phone: 'Call',
    mail: 'Email',
    visit: 'In person',
    hours: 'Mon – Fri 9 am to 5 pm',
    hello: 'We look forward to hearing from you!',
    here: 'Jenomics',
  },
}[lang];

const check =
  '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
const ico = {
  phone:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>',
  pin: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  heart:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/></svg>',
  file: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>',
};
// Growth curve for the story scene (0..100 viewBox, y down)
const curve = 'M4 88 C 20 86, 30 80, 42 70 S 64 46, 74 36 S 90 16, 96 10';
const avatars = Array.from({ length: 9 }, (_, i) => i);
const pins = [
  [48, 34, 'office'],
  [22, 40, ''],
  [70, 58, ''],
  [36, 66, ''],
  [80, 30, ''],
];
---

{
  name === 'story' && (
    <div class="sc-story">
      <svg class="sc-story__chart" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="sc-story-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="var(--hB)" stop-opacity=".35" />
            <stop offset="1" stop-color="var(--hB)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path class="sc-story__area" d={`${curve} L96 100 L4 100 Z`} fill="url(#sc-story-fill)" />
        <path class="sc-story__line" d={curve} pathLength="100" />
      </svg>
      <span class="sc-chip sc-story__pin sc-story__pin--a">
        <b>2001</b>
        <span>
          {T.founded} · {T.founded_sub}
        </span>
      </span>
      <span class="sc-chip sc-story__pin sc-story__pin--b">
        <b>{T.today}</b>
        <span>{T.today_sub}</span>
      </span>
      <div class="sc-story__crew">
        {avatars.map((i) => (
          <span class="sc-avatar" style={`--k:${i}`} />
        ))}
      </div>
      <div class="sc-story__axis">
        <span>2001</span>
        <span>{Math.round((FOUNDED + now) / 2)}</span>
        <span>{now}</span>
      </div>
    </div>
  )
}

{
  name === 'values' && (
    <div class="sc-values">
      <div class="sc-card sc-values__bubble">
        <span class="sc-avatar" />
        <span>{T.simple}</span>
      </div>
      <ul class="sc-win sc-values__list">
        {T.points.map((p, i) => (
          <li style={`--k:${i}`}>
            <i set:html={check} />
            {p}
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  name === 'commit' && (
    <div class="sc-commit">
      <span class="sc-commit__heart" set:html={ico.heart} />
      {T.commit.map((c, i) => (
        <span class={`sc-card sc-commit__chip sc-commit__chip--${i}`} style={`--k:${i}`}>
          {c}
        </span>
      ))}
    </div>
  )
}

{
  name === 'crew' && (
    <div class="sc-crew">
      <svg class="sc-crew__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 25 L50 50 L80 25 M20 75 L50 50 L80 75 M50 15 L50 85" />
      </svg>
      {[
        [20, 25],
        [50, 15],
        [80, 25],
        [20, 75],
        [50, 85],
        [80, 75],
      ].map(([x, y], i) => (
        <span class="sc-crew__p" style={`left:${x}%;top:${y}%;--k:${i}`}>
          <span class="sc-avatar" />
          <i />
        </span>
      ))}
      <span class="sc-crew__hub">
        <img src="/media/jenomics-signet.png" alt="" width="34" height="34" />
      </span>
      {T.crew.map((c, i) => (
        <span class={`sc-chip sc-crew__say sc-crew__say--${i}`} style={`--k:${i}`}>
          {c}
        </span>
      ))}
    </div>
  )
}

{
  name === 'globe' && (
    <div class="sc-globe">
      <div class="sc-globe__ball">
        <span class="sc-globe__lat" />
        <span class="sc-globe__mer" />
        <span class="sc-globe__mer sc-globe__mer--2" />
        <span class="sc-globe__mer sc-globe__mer--3" />
        {pins.map(([x, y, k], i) => (
          <span class:list={['sc-globe__pin', { 'is-home': k === 'office' }]} style={`left:${x}%;top:${y}%;--k:${i}`}>
            <b />
          </span>
        ))}
        <svg class="sc-globe__arcs" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M48 34 Q 34 26 22 40" />
          <path d="M48 34 Q 66 38 70 58" />
          <path d="M48 34 Q 38 52 36 66" />
          <path d="M48 34 Q 66 24 80 30" />
        </svg>
      </div>
      <span class="sc-chip sc-globe__chip">
        <i set:html={ico.pin} />
        {T.office}
      </span>
      <span class="sc-chip sc-globe__chip2"><span class="sc-live" />{T.remote}</span>
    </div>
  )
}

{
  name === 'apply' && (
    <div class="sc-apply">
      <ul class="sc-apply__jobs">
        {T.jobs.map(([j, tag], i) => (
          <li class:list={['sc-card', { 'is-pick': i === 1 }]} style={`--k:${i}`}>
            <span class="sc-apply__ico">{['W', 'L', 'J'][i]}</span>
            <span class="sc-apply__txt">
              <b>{j}</b>
              <small>{tag}</small>
            </span>
            <em>{T.apply}</em>
          </li>
        ))}
      </ul>
      <div class="sc-card sc-apply__up">
        <i set:html={ico.file} />
        <span>{T.cv}</span>
        <span class="sc-fill" style="--k:3;--g:.7s" />
      </div>
      <span class="sc-chip sc-late sc-apply__ok" style="--dl:1.2s">
        <i set:html={check} />
        {T.sent}
      </span>
      <span class="sc-apply__cursor" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M4 2.5 20 11l-7 1.8L9.2 20z" />
        </svg>
      </span>
    </div>
  )
}

{
  name === 'meter' && (
    <div class="sc-win sc-meter">
      <div class="sc-bar">
        <span class="sc-live" />
        {T.session}
        <em>{T.task}</em>
      </div>
      <div class="sc-meter__body">
        <div class="sc-meter__clock">
          <span class="sc-meter__mm" />
          <small>min</small>
        </div>
        <dl>
          <div>
            <dt>{T.tariff}</dt>
            <dd>{T.tariff_v}</dd>
          </div>
          <div>
            <dt>{T.daytime}</dt>
            <dd>{T.daytime_v}</dd>
          </div>
        </dl>
        <span class="sc-meter__track">
          {Array.from({ length: 60 }, (_, i) => (
            <i style={`--k:${i}`} />
          ))}
        </span>
      </div>
      <span class="sc-chip sc-meter__chip">
        <i set:html={check} />
        {T.billed}
      </span>
    </div>
  )
}

{
  name === 'invoice' && (
    <div class="sc-win sc-inv">
      <div class="sc-bar">
        {T.invoice}
        <em>#2026-0412</em>
      </div>
      <ul>
        {T.lines.map(([l, m], i) => (
          <li class="sc-s" style={`--k:${i};--g:.5s`}>
            <span>{l}</span>
            <b>{m}</b>
          </li>
        ))}
        <li class="sc-inv__sum sc-s" style="--k:4;--g:.5s">
          <span>{T.total}</span>
          <b>{T.total_v}</b>
        </li>
      </ul>
      <span class="sc-inv__lens" />
    </div>
  )
}

{
  name === 'tariff' && (
    <div class="sc-tariff">
      <div class="sc-card sc-tariff__task">
        <small>{T.task_l}</small>
        <b>{T.task}</b>
      </div>
      <span class="sc-tariff__arrow" />
      <div class="sc-card sc-tariff__who">
        <small>{T.who}</small>
        <span class="sc-stack">
          {[0, 1, 2].map((k) => (
            <span class="sc-avatar sc-c3" style={`--k:${k};--o:${k}`} />
          ))}
        </span>
      </div>
      <span class="sc-tariff__arrow" />
      <div class="sc-card sc-tariff__out">
        <small>{T.tariff}</small>
        <b>{T.tariff_v}</b>
        <em>{T.same}</em>
      </div>
    </div>
  )
}

{
  name === 'minute' && (
    <div class="sc-minute">
      <div class="sc-minute__ring">
        <div class="sc-minute__in">
          <b>37</b>
          <small>{T.minutes}</small>
        </div>
      </div>
      <div class="sc-minute__note">
        <s>60</s>
        <span>{T.not_rounded}</span>
      </div>
    </div>
  )
}

{
  name === 'clock24' && (
    <div class="sc-c24">
      <div class="sc-c24__sky">
        <span class="sc-c24__sun" />
        <span class="sc-c24__moon" />
        {[12, 30, 58, 76, 88].map((x, i) => (
          <i class="sc-c24__star" style={`left:${x}%;top:${18 + (i % 3) * 12}%`} />
        ))}
        <span class="sc-c24__city">
          {[40, 62, 48, 80, 54, 70, 44, 66].map((h) => (
            <i style={`height:${h}%`} />
          ))}
        </span>
      </div>
      <span class="sc-chip sc-c24__chip">
        <span class="sc-live" />
        {T.service_on}
        <span class="sc-stack sc-c24__when">
          <b class="sc-c24__day">· {T.day}</b>
          <b class="sc-c24__night">· {T.night}</b>
        </span>
      </span>
    </div>
  )
}

{
  name === 'skills' && (
    <div class="sc-skills">
      <span class="sc-skills__hub">{T.one_team}</span>
      {T.areas.map((a, i) => (
        <span class="sc-card sc-skills__tile" style={`--a:${i * 45}deg;--k:${i}`}>
          {a}
        </span>
      ))}
    </div>
  )
}

{
  name === 'ondemand' && (
    <div class="sc-win sc-od">
      <div class="sc-od__head">
        <span>{T.base}</span>
        <b>0 €</b>
      </div>
      <div class="sc-od__chart">
        {[0, 34, 0, 72, 18, 0].map((h, i) => (
          <span style={`--h:${h}%;--k:${i}`}>
            <i />
            <small>{T.weeks[i]}</small>
          </span>
        ))}
      </div>
      <span class="sc-od__tag">{T.usage}</span>
    </div>
  )
}

{
  name === 'channels' && (
    <div class="sc-ch">
      <span class="sc-ch__hub">
        <img src="/media/jenomics-signet.png" alt="" width="40" height="40" />
      </span>
      {[
        ['phone', T.phone],
        ['mail', T.mail],
        ['pin', T.visit],
      ].map(([k, l], i) => (
        <span class={`sc-card sc-ch__node sc-ch__node--${i}`} style={`--k:${i}`}>
          <i set:html={ico[k as keyof typeof ico]} />
          {l}
        </span>
      ))}
      <svg class="sc-ch__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M50 50 L22 26" />
        <path d="M50 50 L80 30" />
        <path d="M50 50 L52 82" />
      </svg>
      <span class="sc-chip sc-ch__hours">{T.hours}</span>
      <span class="sc-chip sc-late sc-ch__hello" style="--dl:.6s">
        <i set:html={check} />
        {T.hello}
      </span>
    </div>
  )
}

{
  name === 'map' && (
    <div class="sc-map">
      <span class="sc-map__river" />
      <span class="sc-map__road sc-map__road--a" />
      <span class="sc-map__road sc-map__road--b" />
      <span class="sc-map__road sc-map__road--c" />
      <span class="sc-map__park" />
      <span class="sc-map__pin">
        <img src="/media/jenomics-signet.png" alt="" width="26" height="26" />
      </span>
      <span class="sc-map__ring" />
    </div>
  )
}

<style is:global>
  /* ---------- story: growth since 2001 ---------- */
  .sc-story {
    position: absolute;
    inset: 0;
  }
  .sc-story__chart {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 14%;
    bottom: 18%;
    width: 88%;
    height: 68%;
    overflow: visible;
  }
  .sc-story__line {
    fill: none;
    stroke: var(--hA);
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    animation: sc-sign 9s var(--jx-ease) infinite both;
  }
  .sc-story__area {
    animation: sc-cover 9s var(--jx-ease) infinite both;
  }
  .sc-story__pin {
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 7px 12px;
    white-space: normal;
    max-width: 46%;
  }
  .sc-story__pin b {
    font-weight: 600;
    color: var(--hA);
  }
  .sc-story__pin span {
    font-size: 10.5px;
    color: var(--jx-grey);
  }
  .sc-chip.sc-story__pin--a {
    left: 7%;
    bottom: 26%;
    animation: sc-pop 9s var(--jx-ease) infinite both;
    animation-delay: -3.2s;
  }
  .sc-chip.sc-story__pin--b {
    right: 6%;
    top: 6%;
    animation: sc-pop 9s var(--jx-ease) infinite both;
    animation-delay: 0.6s;
  }
  .sc-story__crew {
    position: absolute;
    right: 8%;
    bottom: 22%;
    display: grid;
    grid-template-columns: repeat(3, 22px);
    gap: 5px;
  }
  .sc-story__crew .sc-avatar {
    width: 22px;
    height: 22px;
    opacity: 0;
    animation: sc-seq 9s var(--jx-ease) infinite both;
    animation-delay: calc(1.2s + var(--k) * 0.25s);
  }
  .sc-story__axis {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 7%;
    display: flex;
    justify-content: space-between;
    padding-top: 6px;
    border-top: 1px solid rgba(30, 61, 126, 0.12);
    font-weight: 500;
    font-size: 10.5px;
    color: var(--jx-grey);
  }

  /* ---------- values: it does not have to be complicated ---------- */
  .sc-values {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 14px;
    width: min(100%, 300px);
  }
  .sc-values__bubble {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 16px 16px 16px 4px;
    font-weight: 500;
    color: var(--jx-navy);
    animation: jx-float 7s ease-in-out infinite;
  }
  .sc-values__list {
    margin: 0;
    padding: 10px 14px;
    list-style: none;
  }
  .sc-values__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
  }
  .sc-values__list i {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1.5px solid #cfd8e2;
    color: transparent;
    animation: sc-tick 8s var(--jx-ease) infinite;
    animation-delay: calc(var(--k) * 0.6s);
  }

  /* ---------- commit: values float around a heart ---------- */
  .sc-commit {
    position: absolute;
    inset: 0;
  }
  .sc-commit__heart {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    translate: -50% -50%;
    border-radius: 18px;
    color: #fff;
    background: linear-gradient(140deg, var(--hA), var(--hC));
    box-shadow: 0 0 0 8px color-mix(in oklab, var(--hB) 18%, transparent);
    animation: sc-guard 3s ease-in-out infinite;
  }
  .sc-card.sc-commit__chip {
    position: absolute;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 11px;
    color: var(--jx-navy);
    white-space: nowrap;
    translate: -50% -50%;
    animation: jx-float 7s ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.1s);
  }
  .sc-commit__chip--0 {
    left: 24%;
    top: 20%;
  }
  .sc-commit__chip--1 {
    left: 74%;
    top: 18%;
  }
  .sc-commit__chip--2 {
    left: 20%;
    top: 52%;
  }
  .sc-commit__chip--3 {
    left: 80%;
    top: 50%;
  }
  .sc-commit__chip--4 {
    left: 30%;
    top: 82%;
  }
  .sc-commit__chip--5 {
    left: 72%;
    top: 82%;
  }

  /* ---------- crew: team network, the motto pops up ---------- */
  .sc-crew {
    position: absolute;
    inset: 8% 10%;
  }
  .sc-crew__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sc-crew__lines path {
    fill: none;
    stroke: var(--hA);
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
    animation: sc-flow 1.6s linear infinite;
  }
  .sc-crew__p {
    position: absolute;
    translate: -50% -50%;
    animation: jx-float 7s ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.2s);
  }
  .sc-crew__p .sc-avatar {
    display: block;
    width: 40px;
    height: 40px;
    opacity: 1;
    box-shadow: 0 0 0 4px #fff;
    background: linear-gradient(140deg, color-mix(in oklab, var(--hA) calc(100% - var(--k) * 12%), #fff), var(--hB));
  }
  .sc-crew__p i {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--sc-ok);
    box-shadow: 0 0 0 2px #fff;
  }
  .sc-crew__hub {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 8px color-mix(in oklab, var(--hB) 20%, transparent),
      0 12px 26px rgba(30, 61, 126, 0.2);
  }
  .sc-chip.sc-crew__say {
    padding: 6px 12px;
    color: var(--jx-navy);
    animation: sc-say 9s var(--jx-ease) infinite both;
    animation-delay: calc(var(--k) * 3s);
  }
  @keyframes sc-say {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    4%,
    30% {
      opacity: 1;
      transform: none;
    }
    35%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .sc-crew__say--0 {
    left: 28%;
    top: 6%;
  }
  .sc-crew__say--1 {
    right: 4%;
    top: 44%;
  }
  .sc-crew__say--2 {
    left: 10%;
    bottom: 4%;
  }

  /* ---------- globe: distributed team, office in Munich ---------- */
  .sc-globe {
    position: relative;
    z-index: 1;
  }
  .sc-globe__ball {
    position: relative;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, #fff 0, transparent 45%),
      linear-gradient(140deg, color-mix(in oklab, var(--hB) 30%, #fff), color-mix(in oklab, var(--hA) 40%, #fff));
    box-shadow:
      inset -14px -18px 36px color-mix(in oklab, var(--hA) 35%, transparent),
      0 18px 40px rgba(30, 61, 126, 0.2);
    overflow: hidden;
  }
  .sc-globe__lat {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, transparent 0 30px, rgba(255, 255, 255, 0.5) 30px 31px);
  }
  .sc-globe__mer {
    position: absolute;
    left: 50%;
    top: 0;
    width: 100%;
    height: 100%;
    translate: -50% 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.6);
    animation: sc-mer 9s linear infinite;
  }
  .sc-globe__mer--2 {
    animation-delay: -3s;
  }
  .sc-globe__mer--3 {
    animation-delay: -6s;
  }
  @keyframes sc-mer {
    from {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.05);
    }
    to {
      transform: scaleX(1);
    }
  }
  .sc-globe__pin {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 2px var(--hA);
  }
  .sc-globe__pin b {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid #fff;
    animation: sc-ring 2.4s ease-out infinite;
    animation-delay: calc(var(--k) * -0.5s);
  }
  .sc-globe__pin.is-home {
    width: 14px;
    height: 14px;
    background: var(--jx-navy);
    box-shadow: 0 0 0 3px #fff;
  }
  .sc-globe__arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sc-globe__arcs path {
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-dasharray: 2 4;
    animation: sc-flow 1.4s linear infinite;
  }
  .sc-chip.sc-globe__chip {
    left: 52%;
    top: 4px;
    padding: 6px 12px 6px 8px;
    color: var(--jx-navy);
    animation: jx-float 6s ease-in-out infinite;
  }
  .sc-globe__chip i {
    background: var(--jx-navy);
  }
  .sc-chip.sc-globe__chip2 {
    right: 58%;
    bottom: 8px;
    padding: 6px 12px;
    color: var(--jx-navy);
    animation: jx-float 7s ease-in-out infinite -3s;
  }

  /* ---------- apply: pick a job, upload, received ---------- */
  .sc-apply {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 10px;
    width: min(100%, 340px);
  }
  .sc-apply__jobs {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sc-apply__jobs li {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    transition: none;
  }
  .sc-apply__jobs li.is-pick {
    animation: sc-pick 9s var(--jx-ease) infinite;
  }
  @keyframes sc-pick {
    0%,
    14%,
    90%,
    100% {
      box-shadow: 0 8px 22px rgba(30, 61, 126, 0.13);
    }
    20%,
    84% {
      box-shadow:
        0 0 0 2px var(--hA),
        0 10px 26px rgba(30, 61, 126, 0.18);
    }
  }
  .sc-apply__ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: #fff;
    background: linear-gradient(140deg, var(--hA), var(--hB));
    font-weight: 600;
  }
  .sc-apply__txt {
    display: grid;
    min-width: 0;
  }
  .sc-apply__txt b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  .sc-apply__txt small {
    color: var(--jx-grey);
    font-size: 10.5px;
  }
  .sc-apply__jobs em {
    padding: 4px 10px;
    border-radius: 7px;
    font-style: normal;
    font-weight: 500;
    font-size: 10.5px;
    color: var(--hA);
    background: color-mix(in oklab, var(--hA) 12%, #fff);
  }
  .sc-apply__up {
    display: grid;
    grid-template-columns: 16px auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    color: var(--jx-navy);
    font-size: 11px;
    animation: sc-seq 9s var(--jx-ease) infinite both;
    animation-delay: 1.6s;
  }
  .sc-apply__up > i {
    display: grid;
    color: var(--hA);
  }
  .sc-apply__up .sc-fill {
    --d: 9s;
  }
  .sc-chip.sc-apply__ok {
    --d: 9s;
    right: 0;
    bottom: -16px;
  }
  .sc-apply__cursor {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    right: 22px;
    top: 50px;
    animation: sc-curs 9s var(--jx-ease-io) infinite;
  }
  .sc-apply__cursor svg {
    width: 100%;
    height: 100%;
    fill: var(--jx-navy);
    stroke: #fff;
    stroke-width: 1.5;
  }
  @keyframes sc-curs {
    0% {
      transform: translate(-60px, 90px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    16%,
    20% {
      transform: none;
    }
    18% {
      scale: 0.85;
    }
    40%,
    100% {
      transform: translate(40px, 100px);
      opacity: 0;
    }
  }

  /* ---------- meter: minutes tick, tariff and time of day shown ---------- */
  @property --sc-min {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .sc-meter {
    width: min(100%, 360px);
  }
  .sc-meter__body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 18px;
    align-items: center;
    padding: 14px 16px 20px;
  }
  .sc-meter__clock {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .sc-meter__mm {
    counter-reset: m var(--sc-min);
    font-weight: 600;
    font-size: 40px;
    line-height: 1;
    color: var(--jx-navy);
    font-variant-numeric: tabular-nums;
    animation: sc-min 9s linear infinite;
  }
  .sc-meter__mm::after {
    content: counter(m);
  }
  @keyframes sc-min {
    0% {
      --sc-min: 0;
    }
    70%,
    100% {
      --sc-min: 37;
    }
  }
  .sc-meter__clock small {
    color: var(--jx-grey);
  }
  .sc-meter dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .sc-meter dl div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 11px;
  }
  .sc-meter dt {
    color: var(--jx-grey);
  }
  .sc-meter dd {
    margin: 0;
    font-weight: 600;
    color: var(--hA);
  }
  .sc-meter__track {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(60, 1fr);
    gap: 2px;
    height: 16px;
  }
  .sc-meter__track i {
    border-radius: 2px;
    background: #e6edf3;
    animation: sc-tickm 9s linear infinite both;
    animation-delay: calc(var(--k) * 0.105s);
  }
  .sc-meter__track i:nth-child(n + 38) {
    animation: none;
  }
  @keyframes sc-tickm {
    0%,
    1% {
      background: #e6edf3;
    }
    2%,
    92% {
      background: var(--hA);
    }
    100% {
      background: #e6edf3;
    }
  }
  .sc-chip.sc-meter__chip {
    right: 14px;
    bottom: -16px;
    animation: sc-pop 9s var(--jx-ease) infinite both;
    animation-delay: 1.2s;
  }

  /* ---------- invoice: itemised lines, a lens runs over them ---------- */
  .sc-inv {
    width: min(100%, 300px);
  }
  .sc-inv ul {
    margin: 0;
    padding: 6px 14px 12px;
    list-style: none;
  }
  .sc-inv li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px dashed #e3e9f0;
    font-size: 11px;
  }
  .sc-inv li b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--jx-navy);
  }
  .sc-inv li.sc-inv__sum {
    border-bottom: 0;
    font-weight: 600;
  }
  .sc-inv li.sc-inv__sum b {
    color: var(--hA);
  }
  .sc-inv__lens {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 44px;
    height: 30px;
    border-radius: 8px;
    border: 2px solid color-mix(in oklab, var(--hA) 60%, transparent);
    background: color-mix(in oklab, var(--hB) 8%, transparent);
    animation: sc-lens 8s var(--jx-ease-io) infinite;
  }
  @keyframes sc-lens {
    0%,
    30% {
      transform: translateY(0);
      opacity: 0;
    }
    36% {
      opacity: 1;
    }
    50% {
      transform: translateY(30px);
    }
    64% {
      transform: translateY(60px);
    }
    78%,
    86% {
      transform: translateY(90px);
      opacity: 1;
    }
    94%,
    100% {
      transform: translateY(90px);
      opacity: 0;
    }
  }

  /* ---------- tariff: the task decides the tariff, not the person ---------- */
  .sc-tariff {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sc-tariff .sc-card {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 12px 12px;
    min-width: 76px;
    text-align: center;
    font-size: 11px;
  }
  .sc-tariff small {
    color: var(--jx-grey);
    font-size: 10px;
  }
  .sc-tariff b {
    font-weight: 600;
    color: var(--jx-navy);
  }
  .sc-tariff__who .sc-avatar {
    width: 34px;
    height: 34px;
    opacity: 1;
    background: linear-gradient(140deg, color-mix(in oklab, var(--hA) calc(100% - var(--o) * 30%), var(--hC)), var(--hB));
  }
  .sc-tariff__out {
    box-shadow:
      0 0 0 2px var(--hA),
      0 10px 24px rgba(30, 61, 126, 0.16);
  }
  .sc-tariff__out b {
    color: var(--hA);
  }
  .sc-tariff__out em {
    padding: 2px 8px;
    border-radius: 999px;
    font-style: normal;
    font-size: 10px;
    color: #1f8a45;
    background: color-mix(in oklab, var(--sc-ok) 16%, #fff);
  }
  .sc-tariff__arrow {
    width: 18px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--hA) 0 3px, transparent 3px 6px);
    animation: sc-drip-x 0.8s linear infinite;
  }
  @keyframes sc-drip-x {
    to {
      background-position: 6px 0;
    }
  }

  /* ---------- minute: 37 minutes are 37 minutes ---------- */
  @property --sc-p {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  .sc-minute {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .sc-minute__ring {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: conic-gradient(var(--hA) calc(var(--sc-p) * 1%), #e6edf3 0);
    animation: sc-ring37 8s var(--jx-ease) infinite;
  }
  @keyframes sc-ring37 {
    0%,
    6% {
      --sc-p: 0;
    }
    46%,
    88% {
      --sc-p: 61.7;
    }
    100% {
      --sc-p: 0;
    }
  }
  .sc-minute__in {
    display: grid;
    place-items: center;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 18px rgba(30, 61, 126, 0.1);
  }
  .sc-minute__in b {
    font-weight: 600;
    font-size: 36px;
    line-height: 1;
    color: var(--jx-navy);
  }
  .sc-minute__in small {
    margin-top: -14px;
    color: var(--jx-grey);
  }
  .sc-minute__note {
    display: grid;
    gap: 2px;
    font-size: 11px;
    color: var(--jx-grey);
  }
  .sc-minute__note s {
    font-weight: 600;
    font-size: 22px;
    color: #b9c6d6;
    text-decoration-color: var(--sc-bad);
    text-decoration-thickness: 2px;
  }

  /* ---------- clock24: day turns to night, the service stays on ---------- */
  .sc-c24 {
    position: absolute;
    inset: 0;
  }
  .sc-c24__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #bfe6fb, #eaf6fd);
    animation: sc-sky 10s ease-in-out infinite;
    overflow: hidden;
  }
  @keyframes sc-sky {
    0%,
    35%,
    100% {
      background-color: #bfe6fb;
      filter: none;
    }
    50%,
    85% {
      filter: brightness(0.32) saturate(1.4) hue-rotate(10deg);
    }
  }
  .sc-c24__sun,
  .sc-c24__moon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 34px;
    margin: -17px;
    border-radius: 50%;
    transform-origin: 50% 160px;
  }
  .sc-c24__sun {
    background: #ffd66b;
    box-shadow: 0 0 30px 8px rgba(255, 214, 107, 0.7);
    animation: sc-orbit 10s ease-in-out infinite;
  }
  .sc-c24__moon {
    background: #fff;
    box-shadow:
      inset -8px -4px 0 #dfe6f2,
      0 0 22px 4px rgba(255, 255, 255, 0.6);
    animation: sc-orbit 10s ease-in-out infinite -5s;
  }
  @keyframes sc-orbit {
    0% {
      transform: translateY(-40px) rotate(-60deg);
    }
    25% {
      transform: translateY(-40px) rotate(0);
    }
    50%,
    100% {
      transform: translateY(-40px) rotate(60deg);
    }
  }
  .sc-c24__star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    animation: sc-star 10s ease-in-out infinite;
  }
  @keyframes sc-star {
    0%,
    40%,
    95%,
    100% {
      opacity: 0;
    }
    55%,
    82% {
      opacity: 1;
    }
  }
  .sc-c24__city {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 0 6%;
  }
  .sc-c24__city i {
    flex: 1;
    border-radius: 4px 4px 0 0;
    background: color-mix(in oklab, var(--hA) 60%, #0b1a36);
    background-image: repeating-linear-gradient(180deg, transparent 0 8px, rgba(255, 230, 150, 0.0) 8px 11px);
  }
  .sc-chip.sc-c24__chip {
    left: 50%;
    top: 16px;
    translate: -50% 0;
    padding: 7px 14px;
    color: var(--jx-navy);
  }
  .sc-c24__when b {
    font-weight: 500;
    color: var(--jx-grey);
  }
  .sc-c24__day {
    animation: sc-dn 10s ease-in-out infinite;
  }
  .sc-c24__night {
    animation: sc-dn 10s ease-in-out infinite reverse;
    opacity: 0;
  }
  @keyframes sc-dn {
    0%,
    40%,
    95%,
    100% {
      opacity: 1;
    }
    48%,
    86% {
      opacity: 0;
    }
  }

  /* ---------- skills: IT areas around one team ---------- */
  .sc-skills {
    position: relative;
    z-index: 1;
    width: 220px;
    height: 200px;
  }
  .sc-skills__hub {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    translate: -50% -50%;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(140deg, var(--hA), var(--hC));
    font-weight: 600;
    font-size: 11px;
    text-align: center;
    box-shadow: 0 0 0 8px color-mix(in oklab, var(--hB) 18%, transparent);
  }
  .sc-card.sc-skills__tile {
    position: absolute;
    left: 50%;
    top: 50%;
    padding: 5px 10px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 10.5px;
    white-space: nowrap;
    color: var(--jx-navy);
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(-86px) rotate(calc(var(--a) * -1));
    animation: sc-light 8s var(--jx-ease) infinite both;
    animation-delay: calc(var(--k) * 0.5s);
  }
  @keyframes sc-light {
    0%,
    8% {
      background: #fff;
      color: var(--jx-navy);
    }
    12%,
    86% {
      background: var(--hA);
      color: #fff;
    }
    94%,
    100% {
      background: #fff;
      color: var(--jx-navy);
    }
  }

  /* ---------- ondemand: no base fee, costs only in weeks with requests ---------- */
  .sc-od {
    width: min(100%, 300px);
    padding: 14px 16px 16px;
  }
  .sc-od__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    font-weight: 500;
    color: var(--jx-grey);
  }
  .sc-od__head b {
    font-weight: 600;
    font-size: 24px;
    color: var(--hA);
  }
  .sc-od__chart {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    height: 100px;
    align-items: end;
    border-bottom: 2px solid #e3e9f0;
  }
  .sc-od__chart span {
    position: relative;
    display: grid;
    height: 100%;
    align-items: end;
  }
  .sc-od__chart i {
    height: max(var(--h), 3px);
    border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, var(--hB), var(--hA));
